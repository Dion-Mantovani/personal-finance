---
import Layout from '../layouts/Layout.astro';
import { 
  Utensils, ShoppingBag, Car, Zap, Banknote, HeartPulse, Film, ShieldAlert, 
  ArrowLeftRight, Wallet, CreditCard, Landmark, PiggyBank, Coins, ChevronDown,
  ArrowDownLeft, ArrowUpRight, X, Sparkles, History, Calendar, LayoutGrid, StickyNote
} from '@lucide/astro';
---

<Layout title="Form Transaksi" activeTab='history' hideNav fitScreen>
  <form id="tx-form" class="flex flex-col gap-3" novalidate>
    <input type="hidden" id="edit-id" value="" />
    <input type="hidden" id="tx-type" value="expense" />
    <input type="hidden" id="tx-account" value="" />
    <input type="hidden" id="tx-to-account" value="" />
    <input type="hidden" id="tx-category" value="" />

    <!-- Hero: judul + nominal -->
    <section class="relative shrink-0 overflow-hidden rounded-[26px] border border-white/10 bg-brand-navy p-4 text-white shadow-xl">
      <div class="pointer-events-none absolute -right-10 -top-12 h-40 w-40 rounded-full bg-accent-yellow/15 blur-3xl"></div>
      <div class="pointer-events-none absolute -left-12 bottom-[-60px] h-40 w-40 rounded-full bg-white/5"></div>

      <div class="relative z-10 flex flex-col gap-3">
        <div class="flex items-center justify-between gap-3">
          <div class="flex min-w-0 items-center gap-2.5">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/10">
              <Sparkles class="w-3.5 h-3.5 text-accent-yellow" />
            </span>
            <h1 id="tx-page-title" class="truncate text-sm font-bold tracking-tight text-white">Tambah Transaksi</h1>
          </div>

          <a
            href="/history"
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-white/10 bg-white/10 text-white transition hover:bg-white/15 active:scale-95"
            aria-label="Tutup form transaksi"
          >
            <X class="w-3.5 h-3.5" />
          </a>
        </div>

        <div data-field class="tx-amount-field">
          <p class="text-center text-[9px] font-semibold uppercase tracking-[0.18em] text-slate-300">Nominal Transaksi</p>
          <div class="tx-amount-row mt-1.5 flex items-baseline gap-2">
            <span class="text-sm font-bold text-white/70">Rp</span>
            <input
              type="number"
              id="tx-amount"
              placeholder="0"
              min="1"
              step="1"
              required
              enterkeyhint="next"
              aria-label="Nominal transaksi"
              class="min-w-0 flex-1 border-0 bg-transparent text-3xl font-extrabold tracking-tight text-white placeholder:text-white/30 focus:outline-none"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Peringatan bila data master belum ada -->
    <div id="tx-warning" class="hidden shrink-0 space-y-2"></div>

    <!-- Sering Digunakan (Isi Cepat) -->
    <section id="autofill-section" class="hidden shrink-0">
      <div class="mb-1.5 flex items-center gap-1.5 px-1">
        <History class="h-3.5 w-3.5 text-accent-yellow-hover" />
        <span class="text-[11px] font-bold text-brand-navy">Sering Digunakan</span>
        <span class="text-[10px] italic text-text-secondary">(Auto-fill)</span>
      </div>
      <div id="autofill-list" class="no-scrollbar flex gap-2 overflow-x-auto pb-0.5"></div>
    </section>

    <!-- Tipe Transaksi -->
    <div class="shrink-0 rounded-2xl border border-brand-border/70 bg-white p-1 shadow-xs">
      <div class="grid grid-cols-3 gap-1">
        <button
          type="button"
          class="type-tab-btn flex items-center justify-center gap-1 rounded-xl bg-brand-navy py-2 text-xs font-bold text-white shadow-xs transition-all"
          data-type="expense"
        >
          <ArrowDownLeft class="w-3.5 h-3.5" />
          <span>Keluar</span>
        </button>
        <button
          type="button"
          class="type-tab-btn flex items-center justify-center gap-1 rounded-xl py-2 text-xs font-medium text-text-secondary transition-all hover:bg-brand-light hover:text-brand-navy"
          data-type="income"
        >
          <ArrowUpRight class="w-3.5 h-3.5" />
          <span>Masuk</span>
        </button>
        <button
          type="button"
          class="type-tab-btn flex items-center justify-center gap-1 rounded-xl py-2 text-xs font-medium text-text-secondary transition-all hover:bg-brand-light hover:text-brand-navy"
          data-type="transfer"
        >
          <ArrowLeftRight class="w-3.5 h-3.5" />
          <span>Transfer</span>
        </button>
      </div>
    </div>

    <!-- Card field -->
    <div class="flex flex-col rounded-[24px] border border-brand-border/60 bg-white p-4 shadow-lg shadow-slate-200/60">
      <div class="flex flex-col gap-3">
        <div data-field>
          <label class="mb-1.5 flex items-center gap-1.5 text-xs font-semibold text-brand-navy" for="tx-date">
            <Calendar class="w-3.5 h-3.5 text-accent-yellow-hover" />
            Tanggal
          </label>
          <input
            type="date"
            id="tx-date"
            required
            class="w-full rounded-xl border border-brand-border/70 bg-brand-light/60 px-3 py-3 text-[13px] font-semibold text-brand-navy focus:outline-none focus:ring-2 focus:ring-accent-yellow"
          />
        </div>

        <div data-field>
          <label id="account-label" class="mb-1.5 flex items-center gap-1.5 text-xs font-semibold text-brand-navy">
            <Wallet class="w-3.5 h-3.5 text-accent-yellow-hover" />
            <span id="account-label-text">Akun</span>
          </label>
          <button
            type="button"
            id="account-summary-btn"
            class="flex w-full items-center justify-between gap-2 rounded-xl border border-brand-border/70 bg-brand-light/60 px-3 py-3 text-left text-sm focus:outline-none focus:ring-2 focus:ring-accent-yellow"
          >
            <span id="account-summary-text" class="truncate text-text-secondary">Pilih akun...</span>
            <ChevronDown class="w-4 h-4 shrink-0 text-text-secondary" />
          </button>
        </div>

        <div id="category-container" class="relative" data-field>
          <label class="mb-1.5 flex items-center gap-1.5 text-xs font-semibold text-brand-navy">
            <LayoutGrid class="w-3.5 h-3.5 text-accent-yellow-hover" />
            Kategori
          </label>
          <button
            type="button"
            id="category-dropdown-btn"
            class="flex w-full items-center justify-between rounded-xl border border-brand-border/70 bg-brand-light/60 px-3 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-accent-yellow"
          >
            <span id="selected-category-label" class="flex items-center gap-2 text-text-secondary">Pilih Kategori...</span>
            <ChevronDown class="w-4 h-4 text-text-secondary" />
          </button>
          <div id="category-dropdown-menu" class="hidden absolute bottom-full z-30 mb-1 w-full space-y-1 rounded-xl border border-brand-border bg-white p-1 shadow-lg max-h-48 overflow-y-auto"></div>
        </div>

        <div>
          <label class="mb-1.5 flex items-center gap-1.5 text-xs font-semibold text-brand-navy" for="tx-note">
            <StickyNote class="w-3.5 h-3.5 text-accent-yellow-hover" />
            Deskripsi (Opsional)
          </label>
          <input
            type="text"
            id="tx-note"
            enterkeyhint="done"
            placeholder="Tulis detail transaksi di sini..."
            class="w-full rounded-xl border border-brand-border/70 bg-brand-light/60 px-3 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-accent-yellow"
          />
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div id="form-actions-container" class="mt-1 flex gap-2"></div>
  </form>

  <!-- Modal Pilih Akun (sumber / transfer) -->
  <dialog id="tx-account-modal" class="app-dialog" aria-labelledby="tx-account-modal-title">
    <div class="flex max-h-[85vh] flex-col overflow-hidden rounded-2xl border border-brand-border bg-white shadow-xl">
      <div class="flex items-center justify-between border-b border-brand-border/60 px-5 py-4">
        <h2 id="tx-account-modal-title" class="text-base font-bold text-brand-navy">Pilih Akun</h2>
        <button
          type="button"
          id="close-account-modal"
          class="text-text-secondary transition hover:text-brand-navy"
          aria-label="Tutup pilihan akun"
        >
          <X class="w-5 h-5" />
        </button>
      </div>

      <div class="min-h-0 flex-1 overflow-y-auto p-5">
        <section>
          <p id="source-account-heading" class="mb-2 text-xs font-semibold text-brand-navy">Akun Sumber</p>
          <div id="source-account-list" class="space-y-2"></div>
        </section>

        <section id="destination-account-section" class="mt-4 hidden">
          <p class="mb-2 text-xs font-semibold text-brand-navy">Ke Akun Tujuan</p>
          <div id="destination-account-list" class="space-y-2"></div>
        </section>

        <p id="account-modal-hint" class="mt-3 hidden rounded-xl bg-rose-50 px-3 py-2 text-[11px] font-semibold text-finance-red"></p>
      </div>

      <div class="flex gap-2 border-t border-brand-border/60 px-5 py-4">
        <button
          type="button"
          id="account-modal-cancel"
          class="flex-1 rounded-xl bg-brand-light py-2.5 text-xs font-semibold text-text-primary transition hover:bg-slate-200 active:scale-95"
        >
          Batal
        </button>
        <button
          type="button"
          id="account-modal-confirm"
          class="hidden flex-1 rounded-xl bg-accent-yellow py-2.5 text-xs font-bold text-brand-navy transition hover:bg-accent-yellow-hover active:scale-95"
        >
          Lanjut
        </button>
      </div>
    </div>
  </dialog>

  <script>
    import { initTransactionsPage } from '../scripts/transactions';
    initTransactionsPage();
  </script>
</Layout>
