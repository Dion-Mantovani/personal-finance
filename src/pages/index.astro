---
import Layout from '../layouts/Layout.astro';
import {
  ArrowDownLeft,
  ArrowUpRight,
  ChartLine,
  Check,
  ChevronDown,
  CreditCard,
  Eye,
  EyeOff,
  Flame,
  FolderKanban,
  PieChart,
  Plus,
  ReceiptText,
  Repeat,
  Search,
  SlidersHorizontal,
  Sparkles,
  Target,
  TrendingDown,
  TrendingUp,
  Wallet,
  X,
  Zap,
} from '@lucide/astro';

const quickMenus = [
  { id: 'dompet', label: 'Dompet', href: '/accounts', Icon: Wallet },
  { id: 'kategori', label: 'Kategori', href: '/categories', Icon: FolderKanban },
  { id: 'budget', label: 'Budget', href: '/budget', Icon: PieChart },
  { id: 'analitik', label: 'Analitik', href: '/analitik', Icon: ChartLine },
  { id: 'target', label: 'Target', href: '/target', Icon: Target },
  { id: 'tagihan', label: 'Tagihan', href: '/tagihan', Icon: ReceiptText },
  { id: 'langganan', label: 'Langganan', href: '/langganan', Icon: Repeat },
  { id: 'hutang', label: 'Hutang', href: '/hutang', Icon: CreditCard },
];
---

<Layout title="Dashboard" activeTab="dashboard">
  <div class="space-y-5 pb-20">

    <!-- 1. Greeting + Top Actions -->
    <header class="-mt-14 flex items-center justify-between gap-3 pt-3">
      <div class="min-w-0">
        <h1 id="dash-greeting" class="truncate text-base font-extrabold tracking-tight text-primary sm:text-lg">
          Selamat malam
        </h1>
        <p id="dash-date" class="mt-0.5 text-[11px] font-medium text-muted-foreground">—</p>
      </div>

      <div class="flex shrink-0 items-center gap-2">
        <!-- Streak: UI-only dulu, belum dihitung dari data -->
        <button
          type="button"
          class="flex h-9.5 items-center gap-1 rounded-2xl border border-border bg-card px-2.5 text-muted-foreground shadow-xs transition-all active:scale-95"
          title="Streak mencatat"
          aria-label="Streak mencatat 3 hari"
        >
          <Flame class="h-4 w-4 fill-orange-500/20 stroke-orange-500 stroke-[2.2]" />
          <span class="text-[11px] font-extrabold text-primary">3</span>
        </button>

        <a
          href="/history?search=1"
          class="flex h-9.5 w-9.5 items-center justify-center rounded-2xl border border-border bg-card text-muted-foreground shadow-xs transition-all hover:bg-muted active:scale-95"
          title="Cari transaksi"
          aria-label="Cari transaksi"
        >
          <Search class="h-4.5 w-4.5 stroke-2" />
        </a>
      </div>
    </header>

    <!-- 2. Hero Total Saldo -->
    <section class="relative overflow-hidden rounded-[28px] bg-card-blue-dark p-6 text-white shadow-soft">
      <div class="pointer-events-none absolute -right-8 -bottom-10 h-40 w-40 rounded-full bg-white/10"></div>
      <div class="pointer-events-none absolute right-16 -bottom-16 h-32 w-32 rounded-full bg-white/5"></div>

      <div class="relative z-10">
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-2.5">
            <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-white/15 backdrop-blur-md">
              <Wallet class="h-4 w-4 stroke-[2.2] text-white" />
            </span>
            <span class="text-xs font-semibold tracking-wide text-white/80">Total Saldo</span>
          </div>

          <button
            id="toggle-amounts"
            type="button"
            class="flex h-8 w-8 items-center justify-center rounded-full bg-white/15 text-white backdrop-blur-md transition-all hover:bg-white/25 active:scale-95"
            aria-label="Sembunyikan nominal"
            title="Sembunyikan nominal"
          >
            <Eye id="eye-open-icon" class="h-4 w-4 stroke-2" />
            <EyeOff id="eye-closed-icon" class="hidden h-4 w-4 stroke-2" />
          </button>
        </div>

        <h2 id="dash-total-balance" data-amount="0" class="mt-5 text-3xl font-extrabold tracking-tight tabular-nums">
          <span class="inline-block h-9 w-48 animate-pulse rounded-lg bg-white/15 align-middle"></span>
        </h2>

        <div class="mt-2 flex items-center gap-2">
          <div
            id="cashflow-pill"
            class="inline-flex items-center gap-1 rounded-full bg-white/20 px-2.5 py-0.5 text-[10px] font-bold text-finance-green backdrop-blur-md"
          >
            <TrendingUp id="cashflow-up" class="h-3 w-3 stroke-[2.5]" />
            <TrendingDown id="cashflow-down" class="hidden h-3 w-3 stroke-[2.5]" />
            <span id="cashflow-amount" data-amount="0">Rp 0</span>
          </div>
          <span class="text-[10px] font-medium text-white/70">arus kas bulan ini</span>
        </div>

        <div class="mt-5">
          <button
            id="detail-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="hero-detail"
            class="flex w-fit items-center gap-2 rounded-2xl bg-white/15 px-3.5 py-1.5 text-xs font-semibold text-white backdrop-blur-md transition-all hover:bg-white/25 active:scale-95"
          >
            <Sparkles class="h-3.5 w-3.5 stroke-[2.2]" />
            <span id="detail-toggle-label">Lihat Detail</span>
            <ChevronDown id="detail-chevron" class="h-4 w-4 stroke-[2.5] transition-transform duration-300" />
          </button>
        </div>

        <div id="hero-detail" class="mt-4 hidden overflow-hidden">
          <div class="space-y-3 border-t border-white/15 pt-4">
            <div class="flex items-center justify-between gap-3 px-1 text-[10px] font-medium text-white/70">
              <span>Periode <span id="dash-period">Bulan Ini</span></span>
              <span class="rounded-full bg-white/20 px-2 py-0.5 text-[9px] text-white">Aktif</span>
            </div>

            <div class="grid grid-cols-2 gap-2.5">
              <div class="flex items-center gap-2.5 rounded-2xl bg-white/10 p-3 backdrop-blur-xs">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-xl bg-white/20 text-white">
                  <ArrowDownLeft class="h-3.5 w-3.5 stroke-[2.5]" />
                </span>
                <div class="flex min-w-0 flex-col">
                  <span class="text-[10px] font-medium text-white/70">Pemasukan</span>
                  <span id="dash-month-income" data-amount="0" class="truncate text-[11px] font-bold text-white tabular-nums">Rp 0</span>
                </div>
              </div>

              <div class="flex items-center gap-2.5 rounded-2xl bg-white/10 p-3 backdrop-blur-xs">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-xl bg-white/20 text-white">
                  <ArrowUpRight class="h-3.5 w-3.5 stroke-[2.5]" />
                </span>
                <div class="flex min-w-0 flex-col">
                  <span class="text-[10px] font-medium text-white/70">Pengeluaran</span>
                  <span id="dash-month-expense" data-amount="0" class="truncate text-[11px] font-bold text-white tabular-nums">Rp 0</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Quick Menu -->
    <section class="space-y-2">
      <div class="flex items-center justify-between px-1">
        <h3 class="text-xs font-bold text-primary">Menu</h3>
        <button
          type="button"
          id="open-menu-sort"
          class="flex items-center gap-1 text-[10px] font-bold text-blue-main transition-colors hover:text-primary active:scale-95"
        >
          <SlidersHorizontal class="h-3 w-3 stroke-[2.5]" />
          <span>Atur</span>
        </button>
      </div>

      <div
        id="quick-menu-scroll"
        class="no-scrollbar flex items-start gap-3 overflow-x-auto px-1 pb-1"
        aria-label="Menu cepat"
      >
        {quickMenus.map((menu) => {
          const Icon = menu.Icon;
          return (
            <a
              href={menu.href}
              data-menu-id={menu.id}
              data-menu-label={menu.label}
              class="group flex w-[4.35rem] shrink-0 flex-col items-center gap-2"
            >
              <span class="menu-icon flex h-10 w-10 items-center justify-center rounded-2xl border border-border bg-card text-muted-foreground shadow-xs transition-all group-hover:border-blue-main/40 group-hover:bg-blue-soft group-hover:text-blue-main active:scale-95">
                <Icon class="h-4.5 w-4.5 stroke-2" />
              </span>
              <span class="menu-label truncate text-[10px] font-semibold text-muted-foreground transition-colors group-hover:text-primary">
                {menu.label}
              </span>
            </a>
          );
        })}
      </div>
    </section>

    <!-- 4. Catat Cepat -->
    <section id="quick-section" class="space-y-3">
      <div class="flex items-center justify-between gap-2 px-1">
        <div class="flex min-w-0 items-center gap-2">
          <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-blue-soft text-primary shadow-xs">
            <Zap class="h-3.5 w-3.5 fill-current stroke-2" />
          </span>
          <h3 class="truncate text-xs font-extrabold tracking-tight text-primary">Catat Cepat</h3>
          <span class="shrink-0 rounded-full bg-blue-soft px-2 py-0.5 text-[9px] font-extrabold text-blue-main">
            One Click Instant
          </span>
        </div>

        <button
          type="button"
          id="open-custom-quick"
          class="flex shrink-0 items-center gap-1 text-[11px] font-bold text-blue-main transition-colors hover:text-primary active:scale-95"
        >
          <Plus class="h-3.5 w-3.5 stroke-[2.5]" />
          <span>Custom</span>
        </button>
      </div>

      <div class="relative overflow-hidden rounded-[26px] border border-border bg-card p-4 shadow-soft">
        <div class="relative z-10">
          <div id="quick-list" class="no-scrollbar flex items-center gap-2.5 overflow-x-auto"></div>
        </div>
      </div>

      <div
        id="quick-status"
        class="hidden items-center gap-2 rounded-xl border px-3 py-2 text-[11px] font-semibold"
      >
        <span id="quick-status-text"></span>
        <button
          type="button"
          id="quick-undo"
          class="ml-auto shrink-0 text-muted-foreground underline underline-offset-2 hover:text-primary"
        >
          Urungkan
        </button>
      </div>
    </section>

    <!-- 5. Grafik Pengeluaran Mingguan -->
    <section class="space-y-3">
      <div class="flex items-center justify-between px-1">
        <h3 class="text-sm font-bold text-primary">Pengeluaran Mingguan</h3>
        <a href="/history" class="flex items-center gap-0.5 text-xs font-semibold text-blue-main transition-colors hover:text-primary">
          <span>Riwayat</span>
        </a>
      </div>

      <div id="weekly-chart-card" class="relative space-y-4 rounded-[28px] border border-border bg-card p-5 shadow-soft">
        <div class="flex items-center justify-between border-b border-border pb-3">
          <span class="text-xs font-bold text-muted-foreground">Bulan Ini</span>
          <div class="flex items-center gap-1.5 rounded-full bg-blue-soft px-3 py-1">
            <TrendingDown class="h-3 w-3 stroke-[2.5] text-primary" />
            <span id="weekly-expense-total" class="text-[11px] font-bold text-primary">Rp 0</span>
          </div>
        </div>

        <div
          class="flex h-32 w-full items-end justify-between gap-2 px-1 pt-4"
          role="img"
          aria-label="Grafik pengeluaran mingguan"
        >
          <div class="flex w-full flex-col items-center gap-1.5">
            <div class="week-bar h-12 w-full rounded-full bg-blue-soft transition-all"></div>
            <span class="week-label text-[10px] font-bold text-muted-foreground">Sen</span>
          </div>
          <div class="flex w-full flex-col items-center gap-1.5">
            <div class="week-bar h-24 w-full rounded-full bg-primary transition-all"></div>
            <span class="week-label text-[10px] font-bold text-primary">Sel</span>
          </div>
          <div class="flex w-full flex-col items-center gap-1.5">
            <div class="week-bar h-8 w-full rounded-full bg-blue-soft transition-all"></div>
            <span class="week-label text-[10px] font-bold text-muted-foreground">Rab</span>
          </div>
          <div class="flex w-full flex-col items-center gap-1.5">
            <div class="week-bar h-16 w-full rounded-full bg-blue-soft transition-all"></div>
            <span class="week-label text-[10px] font-bold text-muted-foreground">Kam</span>
          </div>
          <div class="flex w-full flex-col items-center gap-1.5">
            <div class="week-bar h-28 w-full rounded-full bg-blue-main transition-all"></div>
            <span class="week-label text-[10px] font-bold text-blue-main">Jum</span>
          </div>
          <div class="flex w-full flex-col items-center gap-1.5">
            <div class="week-bar h-10 w-full rounded-full bg-blue-soft transition-all"></div>
            <span class="week-label text-[10px] font-bold text-muted-foreground">Sab</span>
          </div>
          <div class="flex w-full flex-col items-center gap-1.5">
            <div class="week-bar h-14 w-full rounded-full bg-blue-soft transition-all"></div>
            <span class="week-label text-[10px] font-bold text-muted-foreground">Min</span>
          </div>
        </div>

        <div
          id="weekly-tooltip"
          class="pointer-events-none absolute z-20 hidden min-w-[132px] -translate-x-1/2 rounded-xl bg-primary px-3 py-2 text-center text-white shadow-xl"
          role="status"
          aria-live="polite"
        ></div>
      </div>
    </section>

    <!-- 6. Aktivitas Terakhir -->
    <section class="space-y-3">
      <div class="flex items-center justify-between px-1">
        <h3 class="text-sm font-bold tracking-tight text-primary">Aktivitas Terakhir</h3>
        <a href="/history" class="flex items-center gap-0.5 text-xs font-semibold text-blue-main transition-colors hover:text-primary">
          <span>Lihat Semua</span>
        </a>
      </div>

      <div class="divide-y divide-border overflow-hidden rounded-[28px] border border-border bg-card shadow-soft">
        <div id="dash-recent-list" class="divide-y divide-border">
          <div class="flex animate-pulse items-center gap-3.5 p-4">
            <div class="h-10 w-10 shrink-0 rounded-2xl bg-slate-200/80"></div>
            <div class="min-w-0 flex-1 space-y-2">
              <div class="h-3 w-2/3 rounded bg-slate-200/80"></div>
              <div class="h-2.5 w-1/2 rounded bg-slate-200/70"></div>
            </div>
          </div>
          <div class="flex animate-pulse items-center gap-3.5 p-4">
            <div class="h-10 w-10 shrink-0 rounded-2xl bg-slate-200/80"></div>
            <div class="min-w-0 flex-1 space-y-2">
              <div class="h-3 w-3/5 rounded bg-slate-200/80"></div>
              <div class="h-2.5 w-2/5 rounded bg-slate-200/70"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>

  <!-- Modal Custom Catat Cepat -->
  <dialog id="quick-custom-dialog" class="app-sheet" aria-labelledby="quick-custom-title">
    <div class="sheet-panel">
      <div class="flex items-center justify-between border-b border-border px-5 py-4">
        <h3 id="quick-custom-title" class="text-base font-extrabold text-primary">Custom Catat Cepat</h3>

        <div class="flex items-center gap-1.5">
          <button
            type="button"
            id="quick-manage-open"
            class="flex h-8 w-8 items-center justify-center rounded-full text-muted-foreground transition hover:bg-muted"
            title="Kelola Catat Cepat"
            aria-label="Kelola Catat Cepat"
          >
            <SlidersHorizontal class="h-3.5 w-3.5 stroke-[2.5]" />
          </button>
          <button
            type="button"
            id="quick-custom-close"
            class="flex h-8 w-8 items-center justify-center rounded-full text-muted-foreground transition hover:bg-muted"
            aria-label="Tutup form"
          >
            <X class="h-4 w-4 stroke-[2.5]" />
          </button>
        </div>
      </div>

      <form id="quick-custom-form" class="no-scrollbar min-h-0 flex-1 space-y-4 overflow-y-auto p-5" novalidate>
        <div class="space-y-1.5">
          <label for="quick-name" class="text-[11px] font-bold text-foreground">Nama Transaksi</label>
          <input
            type="text"
            id="quick-name"
            maxlength="40"
            placeholder="Misal: Kopi Kenangan"
            data-autofocus
            class="w-full rounded-2xl border border-border bg-background px-4 py-3 text-xs font-semibold text-foreground outline-none focus:border-blue-main"
          />
        </div>

        <div class="space-y-1.5">
          <label for="quick-type" class="text-[11px] font-bold text-foreground">Tipe Transaksi</label>
          <select
            id="quick-type"
            class="w-full rounded-2xl border border-border bg-background px-4 py-3 text-xs font-semibold text-foreground outline-none focus:border-blue-main"
          >
            <option value="expense">Pengeluaran</option>
            <option value="income">Pemasukan</option>
          </select>
        </div>

        <div class="space-y-1.5">
          <label for="quick-amount" class="text-[11px] font-bold text-foreground">Nominal (Rp)</label>
          <input
            type="text"
            id="quick-amount"
            inputmode="numeric"
            autocomplete="off"
            placeholder="0"
            class="w-full rounded-2xl border border-border bg-background px-4 py-3 text-xs font-bold text-foreground outline-none focus:border-blue-main"
          />
        </div>

        <div class="space-y-1.5">
          <label for="quick-category" class="text-[11px] font-bold text-foreground">Kategori</label>
          <select
            id="quick-category"
            class="w-full rounded-2xl border border-border bg-background px-4 py-3 text-xs font-semibold text-foreground outline-none focus:border-blue-main"
          >
            <option value="">Pilih Kategori</option>
          </select>
        </div>

        <div class="space-y-1.5">
          <label for="quick-account" class="text-[11px] font-bold text-foreground">Akun / Dompet</label>
          <select
            id="quick-account"
            class="w-full rounded-2xl border border-border bg-background px-4 py-3 text-xs font-semibold text-foreground outline-none focus:border-blue-main"
          >
            <option value="">Pilih Akun</option>
          </select>
        </div>

        <div class="pt-1">
          <button
            type="submit"
            id="quick-custom-submit"
            class="flex w-full items-center justify-center gap-2 rounded-2xl bg-primary py-3.5 text-xs font-bold text-primary-foreground shadow-soft transition hover:opacity-90 active:scale-95"
          >
            <Check class="h-4 w-4 stroke-[2.5]" />
            <span>Simpan Shortcut</span>
          </button>
        </div>
      </form>
    </div>
  </dialog>

  <!-- Modal Kelola Catat Cepat -->
  <dialog id="quick-manage-dialog" class="app-sheet" aria-labelledby="quick-manage-title">
    <div class="sheet-panel">
      <div class="flex items-center justify-between border-b border-border px-5 py-4">
        <h3 id="quick-manage-title" class="text-base font-extrabold text-primary">Kelola Catat Cepat</h3>
        <button
          type="button"
          id="quick-manage-close"
          class="flex h-8 w-8 items-center justify-center rounded-full text-muted-foreground transition hover:bg-muted"
          aria-label="Tutup kelola catat cepat"
        >
          <X class="h-4 w-4 stroke-[2.5]" />
        </button>
      </div>

      <div class="no-scrollbar min-h-0 max-h-[60vh] flex-1 space-y-3 overflow-y-auto p-5">
        <p class="text-xs leading-relaxed text-muted-foreground">
          Daftar shortcut catat cepat yang tersimpan (maksimal 5 item). Kalau slot penuh, shortcut terlama akan diganti.
        </p>
        <div id="quick-manage-list" class="space-y-2.5"></div>
      </div>

      <div class="border-t border-border p-5">
        <button
          type="button"
          id="quick-manage-add"
          class="flex w-full items-center justify-center gap-2 rounded-2xl bg-blue-soft py-3.5 text-xs font-bold text-blue-main shadow-soft transition-colors hover:bg-blue-main hover:text-white"
        >
          <Plus class="h-4 w-4 stroke-[2.5]" />
          <span>Tambah Shortcut Baru</span>
        </button>
      </div>
    </div>
  </dialog>

  <!-- Modal Atur Menu -->
  <dialog id="menu-sort-dialog" class="app-sheet" aria-labelledby="menu-sort-title">
    <div class="sheet-panel">
      <div class="flex items-center justify-between border-b border-border px-5 py-4">
        <h3 id="menu-sort-title" class="text-base font-extrabold text-primary">Atur Menu</h3>
        <button
          type="button"
          id="close-menu-sort"
          class="flex h-8 w-8 items-center justify-center rounded-full text-muted-foreground transition hover:bg-muted"
          aria-label="Tutup atur menu"
        >
          <X class="h-4 w-4 stroke-[2.5]" />
        </button>
      </div>

      <div id="menu-sort-list" class="no-scrollbar min-h-0 flex-1 space-y-2 overflow-y-auto p-5"></div>

      <div class="border-t border-border p-5">
        <button
          type="button"
          id="save-menu-sort"
          class="flex w-full items-center justify-center gap-2 rounded-2xl bg-primary py-3.5 text-xs font-bold text-primary-foreground shadow-soft transition hover:opacity-90 active:scale-95"
        >
          <Check class="h-4 w-4 stroke-[2.5]" />
          <span>Simpan Urutan</span>
        </button>
      </div>
    </div>
  </dialog>

  <script>
    import { initDashboardPage } from '../scripts/dashboard';
    initDashboardPage();
  </script>
</Layout>
