---
import Layout from '../layouts/Layout.astro';
import {
  ArrowDownLeft,
  ArrowUpRight,
  ArrowLeftRight,
  Plus,
  Wallet,
  FolderKanban,
  History,
  Settings,
  CreditCard,
  Landmark,
  PiggyBank,
  Coins,
  Utensils,
  ShoppingBag,
  Car,
  Zap,
  Banknote,
  HeartPulse,
  Film,
  ShieldAlert,
  Receipt,
  Eye,
  EyeOff,
  RefreshCw,
  Sparkles,
  ChevronDown,
  TrendingUp,
  TrendingDown,
} from '@lucide/astro';
---

<Layout title="Dashboard" activeTab="dashboard">
  <div class="space-y-5 relative pb-20">

    <!-- 1. Greeting + Top Actions -->
    <header class="flex items-center justify-between gap-3">
      <div class="min-w-0">
        <h1 id="dash-greeting" class="text-xl font-extrabold text-brand-navy tracking-tight">
          Selamat malam
        </h1>
        <p id="dash-date" class="mt-0.5 text-xs font-medium text-text-secondary">—</p>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <button
          id="refresh-btn"
          type="button"
          class="w-10 h-10 rounded-full bg-white border border-brand-border/70 shadow-xs flex items-center justify-center text-brand-navy hover:border-accent-yellow hover:text-accent-yellow-hover active:scale-95 transition disabled:opacity-60 disabled:pointer-events-none"
          aria-label="Muat ulang dashboard"
          title="Muat ulang"
        >
          <RefreshCw id="refresh-icon" class="w-4 h-4" />
        </button>
        <a
          href="/settings"
          class="w-10 h-10 rounded-full bg-white border border-brand-border/70 shadow-xs flex items-center justify-center text-brand-navy hover:border-accent-yellow hover:text-accent-yellow-hover active:scale-95 transition"
          aria-label="Kelola data"
          title="Kelola Data"
        >
          <Settings class="w-4 h-4" />
        </a>
      </div>
    </header>

    <!-- 2. Hero Total Saldo -->
    <section class="relative overflow-hidden rounded-[28px] bg-brand-navy text-white p-5 shadow-xl border border-white/10">
      <div class="absolute -right-12 -top-16 w-48 h-48 rounded-full bg-accent-yellow/15 blur-3xl pointer-events-none"></div>
      <div class="absolute right-[-40px] bottom-[-70px] w-44 h-44 rounded-full bg-white/5 pointer-events-none"></div>
      <div class="absolute left-[-60px] bottom-[-90px] w-52 h-52 rounded-full bg-white/5 pointer-events-none"></div>

      <div class="relative z-10">
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <span class="w-8 h-8 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center">
              <Wallet class="w-4 h-4 text-accent-yellow" />
            </span>
            <span class="text-[11px] font-semibold text-slate-200">Total Saldo</span>
          </div>

          <button
            id="toggle-amounts"
            type="button"
            class="w-8 h-8 rounded-full bg-white/10 border border-white/10 flex items-center justify-center text-slate-200 hover:bg-white/15 active:scale-95 transition"
            aria-label="Sembunyikan nominal"
            title="Sembunyikan nominal"
          >
            <Eye id="eye-open-icon" class="w-4 h-4" />
            <EyeOff id="eye-closed-icon" class="w-4 h-4 hidden" />
          </button>
        </div>

        <h2 id="dash-total-balance" data-amount="0" class="mt-3 text-3xl sm:text-4xl font-extrabold tracking-tight tabular-nums">
          <span class="inline-block h-9 w-48 rounded-lg bg-white/15 animate-pulse align-middle"></span>
        </h2>

        <div
          id="cashflow-pill"
          class="mt-2.5 inline-flex items-center gap-1.5 rounded-full bg-white/10 border border-white/10 px-2.5 py-1 text-[11px] font-semibold text-finance-green"
        >
          <TrendingUp id="cashflow-up" class="w-3.5 h-3.5" />
          <TrendingDown id="cashflow-down" class="w-3.5 h-3.5 hidden" />
          <span id="cashflow-amount" data-amount="0">Rp 0</span>
          <span class="font-medium text-slate-300">arus kas bulan ini</span>
        </div>

        <button
          id="detail-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="hero-detail"
          class="mt-6 inline-flex items-center gap-1.5 rounded-full bg-white/10 border border-white/10 px-3 py-1.5 text-[11px] font-semibold text-slate-100 hover:bg-white/15 active:scale-95 transition"
        >
          <Sparkles class="w-3.5 h-3.5 text-accent-yellow" />
          <span id="detail-toggle-label">Buka Detail</span>
          <ChevronDown id="detail-chevron" class="w-3.5 h-3.5 transition-transform" />
        </button>

        <div id="hero-detail" class="mt-4 hidden">
          <div class="border-t border-white/10 pt-4">
            <div class="flex items-center justify-between gap-3">
              <p class="text-[11px] font-medium text-slate-300">
                Periode <span id="dash-period">Bulan Ini</span>
              </p>
              <span class="inline-flex items-center gap-1 rounded-full bg-white/10 border border-white/10 px-2.5 py-1 text-[10px] font-semibold text-slate-100">
                <span class="w-1.5 h-1.5 rounded-full bg-finance-green"></span>
                Aktif
              </span>
            </div>

            <div class="mt-3 grid grid-cols-2 gap-2.5">
              <div class="rounded-2xl bg-white/10 border border-white/10 p-3">
                <div class="flex items-center gap-2">
                  <span class="w-7 h-7 rounded-full bg-white/10 flex items-center justify-center shrink-0">
                    <ArrowDownLeft class="w-3.5 h-3.5 text-finance-green stroke-[2.5]" />
                  </span>
                  <span class="text-[10px] font-medium text-slate-300">Pemasukan</span>
                </div>
                <p id="dash-month-income" data-amount="0" class="mt-2 text-sm font-bold text-white tabular-nums truncate">
                  Rp 0
                </p>
              </div>

              <div class="rounded-2xl bg-white/10 border border-white/10 p-3">
                <div class="flex items-center gap-2">
                  <span class="w-7 h-7 rounded-full bg-white/10 flex items-center justify-center shrink-0">
                    <ArrowUpRight class="w-3.5 h-3.5 text-finance-red stroke-[2.5]" />
                  </span>
                  <span class="text-[10px] font-medium text-slate-300">Pengeluaran</span>
                </div>
                <p id="dash-month-expense" data-amount="0" class="mt-2 text-sm font-bold text-white tabular-nums truncate">
                  Rp 0
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Shortcut Row -->
    <nav class="grid grid-cols-4 gap-2" aria-label="Aksi cepat">
      <a href="/accounts" class="group flex flex-col items-center gap-2">
        <span class="w-12 h-12 rounded-full bg-white border border-brand-border/70 shadow-xs flex items-center justify-center text-brand-navy group-hover:border-accent-yellow group-hover:text-accent-yellow-hover group-active:scale-95 transition">
          <Wallet class="w-5 h-5" />
        </span>
        <span class="text-[10px] font-semibold text-text-secondary">Dompet</span>
      </a>

      <a href="/categories" class="group flex flex-col items-center gap-2">
        <span class="w-12 h-12 rounded-full bg-white border border-brand-border/70 shadow-xs flex items-center justify-center text-brand-navy group-hover:border-accent-yellow group-hover:text-accent-yellow-hover group-active:scale-95 transition">
          <FolderKanban class="w-5 h-5" />
        </span>
        <span class="text-[10px] font-semibold text-text-secondary">Kategori</span>
      </a>

      <a href="/history" class="group flex flex-col items-center gap-2">
        <span class="w-12 h-12 rounded-full bg-white border border-brand-border/70 shadow-xs flex items-center justify-center text-brand-navy group-hover:border-accent-yellow group-hover:text-accent-yellow-hover group-active:scale-95 transition">
          <History class="w-5 h-5" />
        </span>
        <span class="text-[10px] font-semibold text-text-secondary">Riwayat</span>
      </a>

      <a href="/transactions" class="group flex flex-col items-center gap-2">
        <span class="w-12 h-12 rounded-full bg-white border border-brand-border/70 shadow-xs flex items-center justify-center text-brand-navy group-hover:border-accent-yellow group-hover:text-accent-yellow-hover group-active:scale-95 transition">
          <ArrowLeftRight class="w-5 h-5" />
        </span>
        <span class="text-[10px] font-semibold text-text-secondary">Transaksi</span>
      </a>
    </nav>

    <!-- 4. Catat Cepat (One-tap Create) -->
    <section id="quick-section" class="hidden space-y-3">
      <div class="flex items-center justify-between gap-2 px-1">
        <div class="flex items-center gap-1.5 min-w-0">
          <Zap class="w-4 h-4 text-accent-yellow shrink-0" />
          <h3 class="text-xs font-bold text-brand-navy truncate">Catat Cepat</h3>
          <span class="rounded-full bg-brand-light border border-brand-border/60 px-2 py-0.5 text-[9px] font-semibold text-text-secondary shrink-0">
            1 tap
          </span>
        </div>
        <a
          href="/transactions"
          class="text-[11px] font-semibold text-accent-yellow-hover hover:text-brand-navy transition shrink-0"
        >
          + Custom
        </a>
      </div>

      <div
        id="quick-status"
        class="hidden items-center gap-2 rounded-xl border px-3 py-2 text-[11px] font-semibold"
      >
        <span id="quick-status-text"></span>
        <button
          type="button"
          id="quick-undo"
          class="ml-auto shrink-0 text-text-secondary underline underline-offset-2 hover:text-brand-navy"
        >
          Urungkan
        </button>
      </div>

      <div
        id="quick-list"
        class="no-scrollbar flex gap-3 overflow-x-auto snap-x snap-mandatory scroll-px-4 -mx-4 px-4 pb-2"
      ></div>
    </section>

    <!-- 5. Pengeluaran Mingguan (Placeholder) -->
    <section class="space-y-3">
      <div class="flex items-center justify-between px-1">
        <h3 class="text-sm font-bold text-brand-navy">Pengeluaran Mingguan</h3>
        <a
          href="/history"
          class="text-[11px] font-semibold text-accent-yellow-hover hover:text-brand-navy transition"
        >
          Riwayat &gt;
        </a>
      </div>

      <div class="rounded-3xl bg-white border border-brand-border/70 p-4 shadow-xs">
        <div class="flex items-center justify-between gap-3">
          <span class="text-[11px] font-semibold text-text-secondary">Minggu Ini</span>
          <span class="rounded-full bg-brand-light border border-brand-border/60 px-3 py-1 text-[10px] font-bold text-text-secondary">
            Segera
          </span>
        </div>

        <div
          class="mt-4 flex items-end justify-between gap-2 h-28"
          role="img"
          aria-label="Grafik pengeluaran mingguan, masih placeholder"
        >
          <div class="flex-1 flex flex-col items-center gap-2">
            <div class="h-24 w-full flex items-end justify-center">
              <div class="week-bar w-4 rounded-full bg-brand-border transition-all" style="height: 36%"></div>
            </div>
            <span class="week-label text-[10px] font-medium text-text-secondary">Sen</span>
          </div>

          <div class="flex-1 flex flex-col items-center gap-2">
            <div class="h-24 w-full flex items-end justify-center">
              <div class="week-bar w-4 rounded-full bg-brand-border transition-all" style="height: 68%"></div>
            </div>
            <span class="week-label text-[10px] font-medium text-text-secondary">Sel</span>
          </div>

          <div class="flex-1 flex flex-col items-center gap-2">
            <div class="h-24 w-full flex items-end justify-center">
              <div class="week-bar w-4 rounded-full bg-brand-border transition-all" style="height: 28%"></div>
            </div>
            <span class="week-label text-[10px] font-medium text-text-secondary">Rab</span>
          </div>

          <div class="flex-1 flex flex-col items-center gap-2">
            <div class="h-24 w-full flex items-end justify-center">
              <div class="week-bar w-4 rounded-full bg-brand-border transition-all" style="height: 52%"></div>
            </div>
            <span class="week-label text-[10px] font-medium text-text-secondary">Kam</span>
          </div>

          <div class="flex-1 flex flex-col items-center gap-2">
            <div class="h-24 w-full flex items-end justify-center">
              <div class="week-bar w-4 rounded-full bg-brand-border transition-all" style="height: 82%"></div>
            </div>
            <span class="week-label text-[10px] font-medium text-text-secondary">Jum</span>
          </div>

          <div class="flex-1 flex flex-col items-center gap-2">
            <div class="h-24 w-full flex items-end justify-center">
              <div class="week-bar w-4 rounded-full bg-brand-border transition-all" style="height: 20%"></div>
            </div>
            <span class="week-label text-[10px] font-medium text-text-secondary">Sab</span>
          </div>

          <div class="flex-1 flex flex-col items-center gap-2">
            <div class="h-24 w-full flex items-end justify-center">
              <div class="week-bar w-4 rounded-full bg-brand-border transition-all" style="height: 44%"></div>
            </div>
            <span class="week-label text-[10px] font-medium text-text-secondary">Min</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Aktivitas Terakhir -->
    <section class="space-y-3">
      <div class="flex items-center justify-between px-1">
        <h3 class="text-sm font-bold text-brand-navy">Aktivitas Terakhir</h3>
        <a
          href="/history"
          class="text-[11px] font-semibold text-accent-yellow-hover hover:text-brand-navy transition"
        >
          Lihat Semua &gt;
        </a>
      </div>

      <div id="dash-recent-list" class="space-y-2">
        <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-white border border-brand-border/60 animate-pulse">
          <div class="w-11 h-11 rounded-full bg-slate-200/80 shrink-0"></div>
          <div class="flex-1 space-y-2 min-w-0">
            <div class="h-3 w-2/3 rounded bg-slate-200/80"></div>
            <div class="h-2.5 w-1/2 rounded bg-slate-200/70"></div>
          </div>
        </div>
        <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-white border border-brand-border/60 animate-pulse">
          <div class="w-11 h-11 rounded-full bg-slate-200/80 shrink-0"></div>
          <div class="flex-1 space-y-2 min-w-0">
            <div class="h-3 w-3/5 rounded bg-slate-200/80"></div>
            <div class="h-2.5 w-2/5 rounded bg-slate-200/70"></div>
          </div>
        </div>
        <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-white border border-brand-border/60 animate-pulse">
          <div class="w-11 h-11 rounded-full bg-slate-200/80 shrink-0"></div>
          <div class="flex-1 space-y-2 min-w-0">
            <div class="h-3 w-1/2 rounded bg-slate-200/80"></div>
            <div class="h-2.5 w-1/3 rounded bg-slate-200/70"></div>
          </div>
        </div>
      </div>
    </section>

  </div>

  <!-- Extended FAB -->
  <a
    href="/transactions"
    class="fixed bottom-20 right-6 z-40 flex items-center gap-2.5 px-5 py-3.5 bg-accent-yellow text-brand-navy rounded-full shadow-xl shadow-accent-yellow/30 hover:bg-accent-yellow-hover hover:scale-105 active:scale-95 transition-all font-bold text-sm border-2 border-white/20 group"
    aria-label="Catat Transaksi Baru"
  >
    <div class="w-6 h-6 rounded-full bg-brand-navy text-accent-yellow flex items-center justify-center group-hover:rotate-90 transition-transform duration-300">
      <Plus class="w-4 h-4 stroke-[3]" />
    </div>
    <span class="tracking-wide">Catat Transaksi</span>
  </a>

  <script>
    import { initDashboardPage } from '../scripts/dashboard';
    initDashboardPage();
  </script>
</Layout>
