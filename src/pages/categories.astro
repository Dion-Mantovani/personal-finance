---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import {
  Utensils, Coffee, Pizza, Apple, ShoppingBasket,
  ShoppingBag, ShoppingCart, Shirt, Gift, Package,
  Car, Bus, Bike, Fuel, Plane, TrainFront, CircleParking,
  Zap, Wifi, Droplets, Flame, Phone, ReceiptText,
  HeartPulse, Pill, Stethoscope, Dumbbell,
  Film, Gamepad2, Music, Tv,
  BookOpen, GraduationCap, School,
  House, Sofa, Wrench,
  Briefcase, Laptop, Building2, Banknote, TrendingUp, HandCoins,
  ChartLine, PiggyBank, Coins, Landmark,
  Repeat, RefreshCw, ShieldCheck, ShieldAlert, FileText,
  Baby, Users, PawPrint, Smile, Sparkles, Scissors,
  MoreHorizontal, Tag, CircleHelp,
  Plus, X, ArrowUpRight, ArrowDownLeft,
} from '@lucide/astro';

const categoryIcons = [
  { name: 'Utensils', label: 'Makanan', Icon: Utensils },
  { name: 'Coffee', label: 'Minuman', Icon: Coffee },
  { name: 'Pizza', label: 'Makanan cepat saji', Icon: Pizza },
  { name: 'Apple', label: 'Buah', Icon: Apple },
  { name: 'ShoppingBasket', label: 'Belanja dapur', Icon: ShoppingBasket },
  { name: 'ShoppingBag', label: 'Belanja', Icon: ShoppingBag },
  { name: 'ShoppingCart', label: 'Belanja harian', Icon: ShoppingCart },
  { name: 'Shirt', label: 'Pakaian', Icon: Shirt },
  { name: 'Gift', label: 'Hadiah', Icon: Gift },
  { name: 'Package', label: 'Paket', Icon: Package },
  { name: 'Car', label: 'Mobil', Icon: Car },
  { name: 'Bus', label: 'Bus', Icon: Bus },
  { name: 'Bike', label: 'Sepeda', Icon: Bike },
  { name: 'Fuel', label: 'Bensin', Icon: Fuel },
  { name: 'Plane', label: 'Pesawat', Icon: Plane },
  { name: 'TrainFront', label: 'Kereta', Icon: TrainFront },
  { name: 'CircleParking', label: 'Parkir', Icon: CircleParking },
  { name: 'Zap', label: 'Listrik', Icon: Zap },
  { name: 'Wifi', label: 'Internet', Icon: Wifi },
  { name: 'Droplets', label: 'Air', Icon: Droplets },
  { name: 'Flame', label: 'Gas', Icon: Flame },
  { name: 'Phone', label: 'Telepon', Icon: Phone },
  { name: 'ReceiptText', label: 'Tagihan', Icon: ReceiptText },
  { name: 'HeartPulse', label: 'Kesehatan', Icon: HeartPulse },
  { name: 'Pill', label: 'Obat', Icon: Pill },
  { name: 'Stethoscope', label: 'Medis', Icon: Stethoscope },
  { name: 'Dumbbell', label: 'Olahraga', Icon: Dumbbell },
  { name: 'Film', label: 'Film', Icon: Film },
  { name: 'Gamepad2', label: 'Game', Icon: Gamepad2 },
  { name: 'Music', label: 'Musik', Icon: Music },
  { name: 'Tv', label: 'TV', Icon: Tv },
  { name: 'BookOpen', label: 'Buku', Icon: BookOpen },
  { name: 'GraduationCap', label: 'Pendidikan', Icon: GraduationCap },
  { name: 'School', label: 'Sekolah', Icon: School },
  { name: 'House', label: 'Rumah', Icon: House },
  { name: 'Sofa', label: 'Perabot', Icon: Sofa },
  { name: 'Wrench', label: 'Perbaikan', Icon: Wrench },
  { name: 'Briefcase', label: 'Pekerjaan', Icon: Briefcase },
  { name: 'Laptop', label: 'Freelance', Icon: Laptop },
  { name: 'Building2', label: 'Kantor', Icon: Building2 },
  { name: 'Banknote', label: 'Uang', Icon: Banknote },
  { name: 'TrendingUp', label: 'Pertumbuhan', Icon: TrendingUp },
  { name: 'HandCoins', label: 'Pendapatan', Icon: HandCoins },
  { name: 'ChartLine', label: 'Investasi', Icon: ChartLine },
  { name: 'PiggyBank', label: 'Tabungan', Icon: PiggyBank },
  { name: 'Coins', label: 'Koin', Icon: Coins },
  { name: 'Landmark', label: 'Bank', Icon: Landmark },
  { name: 'Repeat', label: 'Langganan', Icon: Repeat },
  { name: 'RefreshCw', label: 'Berulang', Icon: RefreshCw },
  { name: 'ShieldCheck', label: 'Asuransi', Icon: ShieldCheck },
  { name: 'ShieldAlert', label: 'Darurat', Icon: ShieldAlert },
  { name: 'FileText', label: 'Pajak', Icon: FileText },
  { name: 'Baby', label: 'Anak', Icon: Baby },
  { name: 'Users', label: 'Keluarga', Icon: Users },
  { name: 'PawPrint', label: 'Hewan', Icon: PawPrint },
  { name: 'Smile', label: 'Perawatan diri', Icon: Smile },
  { name: 'Sparkles', label: 'Kecantikan', Icon: Sparkles },
  { name: 'Scissors', label: 'Potong rambut', Icon: Scissors },
  { name: 'MoreHorizontal', label: 'Lainnya', Icon: MoreHorizontal },
  { name: 'Tag', label: 'Label', Icon: Tag },
  { name: 'CircleHelp', label: 'Tidak diketahui', Icon: CircleHelp },
];

const categoryColors = [
  { value: 'text-blue-700 bg-blue-50', swatch: 'bg-blue-main', label: 'Biru', active: true },
  { value: 'text-emerald-700 bg-emerald-50', swatch: 'bg-finance-green', label: 'Hijau' },
  { value: 'text-violet-700 bg-violet-50', swatch: 'bg-violet-500', label: 'Violet' },
  { value: 'text-amber-600 bg-amber-50', swatch: 'bg-amber-500', label: 'Amber' },
  { value: 'text-rose-700 bg-rose-50', swatch: 'bg-finance-red', label: 'Merah' },
];
---

<Layout title="Kategori" activeTab="categories">
  <div class="space-y-5 pb-8">

    <Header title="Kategori Transaksi" showBack centerTitle />

    <!-- Segmented control -->
    <div class="grid grid-cols-2 gap-2 rounded-2xl border border-border bg-card p-1 shadow-xs">
      <button
        id="tab-expense"
        type="button"
        class="tab-btn flex items-center justify-center gap-2 rounded-xl bg-primary py-2 text-xs font-bold text-primary-foreground shadow-soft transition-all"
        data-type="expense"
      >
        <ArrowDownLeft class="h-3.5 w-3.5 stroke-[2.5]" />
        <span>Pengeluaran</span>
      </button>
      <button
        id="tab-income"
        type="button"
        class="tab-btn flex items-center justify-center gap-2 rounded-xl py-2 text-xs font-bold text-muted-foreground transition-all hover:text-foreground"
        data-type="income"
      >
        <ArrowUpRight class="h-3.5 w-3.5 stroke-[2.5]" />
        <span>Pemasukan</span>
      </button>
    </div>

    <!-- Daftar kategori -->
    <div class="space-y-3">
      <div class="flex items-center justify-between gap-2 px-1">
        <h3 id="category-section-title" class="text-xs font-bold text-primary">Kategori Pengeluaran</h3>
        <div class="flex shrink-0 items-center gap-1.5">
          <span id="category-count-badge" class="rounded-full bg-blue-soft px-2.5 py-0.5 text-[9px] font-extrabold text-blue-main">0 Kategori</span>
          <button
            type="button"
            id="sort-toggle"
            class="hidden rounded-full border border-border bg-card px-2.5 py-1 text-[9px] font-bold text-muted-foreground transition-all hover:bg-muted active:scale-95"
          >
            Urutkan
          </button>
        </div>
      </div>

      <div id="categories-list" class="grid grid-cols-2 gap-3">
        <p class="col-span-2 py-8 text-center text-sm text-muted-foreground">Memuat data...</p>
      </div>
    </div>

    <!-- Tambah kategori -->
    <button
      type="button"
      id="open-add-modal"
      class="hidden flex w-full items-center justify-center gap-2 rounded-2xl border border-dashed border-blue-main/40 bg-blue-soft/30 py-3.5 text-blue-main shadow-xs transition-all hover:border-blue-main hover:bg-blue-soft active:scale-95"
      aria-label="Tambah Kategori Baru"
    >
      <Plus class="h-4 w-4 stroke-[2.5]" />
      <span class="text-xs font-bold">Tambah Kategori Baru</span>
    </button>
  </div>

  <!-- Modal detail kategori -->
  <dialog id="category-detail-modal" class="app-sheet" aria-labelledby="detail-modal-name">
    <div class="sheet-panel">
      <div class="relative overflow-hidden bg-card-blue-dark p-6 text-white">
        <div class="pointer-events-none absolute -right-6 -bottom-8 h-28 w-28 rounded-full bg-white/10"></div>

        <div class="relative z-10 flex items-center justify-between">
          <span id="detail-modal-type-badge" class="rounded-full bg-white/20 px-2.5 py-0.5 text-[9px] font-bold uppercase tracking-widest text-white">
            Kategori Pengeluaran
          </span>
          <button
            type="button"
            id="close-detail-modal"
            class="flex h-8 w-8 items-center justify-center rounded-full bg-white/20 text-white transition hover:bg-white/30"
            aria-label="Tutup detail kategori"
          >
            <X class="h-4 w-4 stroke-[2.5]" />
          </button>
        </div>

        <div class="relative z-10 mt-5 flex items-center gap-3.5">
          <div id="detail-modal-icon-wrapper" class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white/20 text-white">
            <!-- Rendered via JS -->
          </div>
          <div class="min-w-0">
            <h3 id="detail-modal-name" class="truncate text-base font-extrabold text-white">Nama Kategori</h3>
            <p class="text-[10px] font-medium text-white/70">Kategori transaksi</p>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-2.5 border-t border-border p-5">
        <button
          type="button"
          id="detail-edit-btn"
          class="flex w-full items-center justify-center gap-1.5 rounded-2xl bg-muted py-3 text-xs font-bold text-primary transition hover:bg-slate-200 active:scale-95"
        >
          Edit Kategori
        </button>
        <button
          type="button"
          id="detail-delete-btn"
          class="flex w-full items-center justify-center gap-1.5 rounded-2xl bg-rose-50 py-3 text-xs font-bold text-rose-600 transition hover:bg-rose-100 active:scale-95"
        >
          Hapus Kategori
        </button>
      </div>
    </div>
  </dialog>

  <!-- Modal form kategori -->
  <dialog id="category-modal" class="app-sheet" aria-labelledby="modal-title">
    <div class="sheet-panel">
      <div class="flex items-center justify-between border-b border-border px-5 py-4">
        <h3 id="modal-title" class="text-base font-extrabold text-primary">Tambah Kategori Baru</h3>
        <button
          type="button"
          id="close-modal"
          class="flex h-8 w-8 items-center justify-center rounded-full text-muted-foreground transition hover:bg-muted"
          aria-label="Tutup form kategori"
        >
          <X class="h-4 w-4 stroke-[2.5]" />
        </button>
      </div>

      <form id="category-form" class="no-scrollbar min-h-0 flex-1 space-y-4 overflow-y-auto p-5" novalidate>
        <input type="hidden" id="edit-id" value="" />
        <input type="hidden" id="icon" value="Utensils" />
        <input type="hidden" id="color" value="text-blue-700 bg-blue-50" />

        <div data-field class="space-y-1.5">
          <label class="block text-[11px] font-bold text-foreground" for="name">Nama Kategori</label>
          <input
            type="text"
            id="name"
            required
            maxlength="30"
            placeholder="cth: Makanan, Gaji, Transport"
            data-autofocus
            class="w-full rounded-2xl border border-border bg-background px-4 py-3 text-xs font-semibold text-foreground outline-none focus:border-blue-main"
          />
        </div>

        <div data-field class="space-y-1.5">
          <label class="block text-[11px] font-bold text-foreground" for="type">Tipe Transaksi</label>
          <select
            id="type"
            class="w-full rounded-2xl border border-border bg-background px-4 py-3 text-xs font-semibold text-foreground outline-none focus:border-blue-main"
          >
            <option value="expense">Pengeluaran (Expense)</option>
            <option value="income">Pemasukan (Income)</option>
          </select>
        </div>

        <div class="space-y-1.5">
          <label class="block text-[11px] font-bold text-foreground">Pilih Icon</label>
          <div id="icon-picker" class="no-scrollbar grid max-h-48 grid-cols-6 gap-2 overflow-y-auto pr-0.5">
            {categoryIcons.map(({ name, label, Icon }, index) => (
              <button
                type="button"
                data-icon-val={name}
                class={`icon-opt flex aspect-square items-center justify-center rounded-xl border-2 transition ${
                  index === 0
                    ? 'border-blue-main bg-blue-soft text-primary'
                    : 'border-border text-muted-foreground hover:border-blue-main'
                }`}
                aria-label={`Ikon ${label}`}
                title={label}
              >
                <Icon class="h-5 w-5" />
              </button>
            ))}
          </div>
        </div>

        <div class="space-y-1.5">
          <label class="block text-[11px] font-bold text-foreground">Pilih Warna Tema</label>
          <div id="color-picker" class="flex items-center gap-3">
            {categoryColors.map((color) => (
              <button
                type="button"
                data-color-val={color.value}
                class={`color-opt h-7 w-7 rounded-full ${color.swatch} transition ${
                  color.active ? 'ring-2 ring-blue-main ring-offset-2' : ''
                }`}
                aria-label={`Warna ${color.label}`}
                title={color.label}
              ></button>
            ))}
          </div>
        </div>

        <div class="flex gap-2 border-t border-border pt-4">
          <button type="button" id="cancel-modal" class="flex-1 rounded-2xl bg-muted py-3 text-xs font-bold text-foreground transition hover:bg-slate-200 active:scale-95">Batal</button>
          <button type="submit" id="submit-btn" class="flex-1 rounded-2xl bg-primary py-3 text-xs font-bold text-primary-foreground shadow-soft transition hover:opacity-90 active:scale-95">Simpan Kategori</button>
        </div>
      </form>
    </div>
  </dialog>

  <script>
    import { initCategoriesPage } from '../scripts/categories';
    initCategoriesPage();
  </script>
</Layout>
