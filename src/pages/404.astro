---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { CircleHelp } from '@lucide/astro';
---

<Layout title="Halaman tidak ditemukan" hideNav>
  <div class="space-y-5 pb-8">
    <Header title="404" showBack centerTitle />

    <div class="flex flex-col items-center justify-center px-6 py-16 text-center">
      <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-soft text-blue-main">
        <CircleHelp class="h-7 w-7 stroke-2" />
      </div>
      <h1 class="mt-5 text-lg font-extrabold tracking-tight text-primary">Halaman belum tersedia</h1>
      <p class="mt-1 max-w-xs text-xs font-medium leading-relaxed text-muted-foreground">
        Menu ini belum dibuat. Fitur akan tersedia pada pembaruan berikutnya.
      </p>
      <a
        href="/"
        class="mt-6 inline-flex items-center justify-center rounded-2xl bg-primary px-5 py-3 text-xs font-bold text-primary-foreground shadow-soft transition hover:opacity-90 active:scale-95"
      >
        Kembali ke Dashboard
      </a>
    </div>
  </div>
</Layout>
