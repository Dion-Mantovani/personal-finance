---
import Layout from '../layouts/Layout.astro';
import { 
  Utensils, ShoppingBag, Car, Zap, Banknote, HeartPulse, Film, ShieldAlert, 
  ArrowLeftRight, Wallet, CreditCard, Landmark, PiggyBank, Coins, 
  Plus, ChevronLeft, ChevronRight, Search, SlidersHorizontal, Download, ArrowUpRight, ArrowDownLeft, Calendar, X, Receipt
} from '@lucide/astro';
---

<Layout title="Riwayat Transaksi" activeTab='history'>
  <div class="space-y-4 relative pb-20">
    
    <!-- 1. Action Bar: month/range/search + 3 icon buttons -->
    <div class="flex items-center gap-2 px-1">
      <!-- Month Picker (Flexible / Lebih Panjang di Kiri) -->
      <div id="month-picker-wrap" class="flex flex-1 items-center justify-between rounded-2xl border border-brand-border/80 bg-white px-3 py-2 shadow-xs">
        <button id="prev-month-btn" type="button" class="rounded-xl p-1.5 text-brand-navy transition-all hover:bg-brand-light active:scale-95" aria-label="Bulan Sebelumnya">
          <ChevronLeft class="w-4 h-4 stroke-[2.5]" />
        </button>
        
        <button id="month-picker-btn" type="button" class="flex items-center gap-1.5 rounded-lg px-1.5 py-1 transition hover:bg-brand-light" aria-label="Pilih bulan" aria-haspopup="dialog">
          <Calendar class="w-4 h-4 shrink-0 text-accent-yellow" />
          <span id="current-month-display" class="font-bold text-xs sm:text-sm text-brand-navy tracking-tight">Nov 2026</span>
        </button>

        <button id="next-month-btn" type="button" class="rounded-xl p-1.5 text-brand-navy transition-all hover:bg-brand-light active:scale-95" aria-label="Bulan Selanjutnya">
          <ChevronRight class="w-4 h-4 stroke-[2.5]" />
        </button>
      </div>

      <!-- Chip rentang tanggal (menggantikan month picker) -->
      <div id="range-picker-wrap" style="display: none;" class="flex flex-1 items-center gap-1.5 rounded-2xl border border-brand-border/80 bg-white px-3 py-2 shadow-xs">
        <button id="range-picker-btn" type="button" class="flex min-w-0 flex-1 items-center gap-1.5 text-left" aria-label="Ubah rentang tanggal">
          <Calendar class="w-4 h-4 shrink-0 text-accent-yellow" />
          <span id="range-picker-label" class="truncate text-xs font-bold text-brand-navy"></span>
        </button>
        <button id="clear-range-btn" type="button" class="shrink-0 rounded-md p-0.5 text-text-secondary transition hover:text-finance-red" aria-label="Hapus rentang tanggal">
          <X class="w-3.5 h-3.5" />
        </button>
      </div>

      <!-- Search realtime (menggantikan month picker) -->
      <div id="search-wrap" style="display: none;" class="flex flex-1 items-center gap-1.5 rounded-2xl border border-accent-yellow bg-white px-3 py-2 shadow-xs">
        <Search class="w-4 h-4 shrink-0 text-accent-yellow-hover" />
        <input
          id="history-search"
          type="search"
          autocomplete="off"
          placeholder="Cari catatan, kategori, akun..."
          aria-label="Cari transaksi"
          class="min-w-0 flex-1 bg-transparent text-xs font-medium text-brand-navy placeholder:text-text-secondary focus:outline-none"
        />
        <button id="search-clear-btn" type="button" style="display: none;" class="shrink-0 rounded-md p-0.5 text-text-secondary transition hover:text-brand-navy" aria-label="Hapus kata kunci">
          <X class="w-3.5 h-3.5" />
        </button>
      </div>

      <!-- 3 Icon Buttons di Kanan -->
      <div class="flex shrink-0 items-center gap-1.5">
        <button id="btn-search-trigger" type="button" class="rounded-2xl border border-brand-border/80 bg-white p-3 text-text-secondary shadow-xs transition hover:border-accent-yellow hover:text-brand-navy" title="Cari Transaksi" aria-label="Cari transaksi" aria-expanded="false" aria-controls="search-wrap">
          <Search class="w-4 h-4" />
        </button>
        <button id="btn-filter-trigger" type="button" class="relative rounded-2xl border border-brand-border/80 bg-white p-3 text-brand-navy shadow-xs transition hover:bg-brand-light" title="Filter Transaksi" aria-label="Filter transaksi">
          <SlidersHorizontal class="w-4 h-4" />
          <span id="filter-badge" class="absolute -top-1 -right-1 h-4 min-w-4 items-center justify-center rounded-full bg-accent-yellow px-1 text-[9px] font-bold text-brand-navy" style="display: none;">0</span>
        </button>
        <button id="btn-export-trigger" type="button" class="rounded-2xl border border-brand-border/80 bg-white p-3 text-brand-navy shadow-xs transition hover:bg-brand-light" title="Export Data" aria-label="Export data transaksi">
          <Download class="w-4 h-4" />
        </button>
      </div>
    </div>

    <!-- 3. Tabs Quick Filter (Semua, Keluar, Masuk, Transfer) -->
    <div class="p-1.5 rounded-2xl bg-slate-200/70 backdrop-blur-md grid grid-cols-4 gap-1 border border-brand-border/40">
      <button 
        class="history-tab-btn py-2 rounded-xl font-bold text-xs text-center transition-all duration-200 bg-white text-brand-navy shadow-xs"
        data-filter="all"
      >
        Semua
      </button>
      <button 
        class="history-tab-btn py-2 rounded-xl font-medium text-xs text-center text-text-secondary hover:text-brand-navy transition-all duration-200"
        data-filter="expense"
      >
        Keluar
      </button>
      <button 
        class="history-tab-btn py-2 rounded-xl font-medium text-xs text-center text-text-secondary hover:text-brand-navy transition-all duration-200"
        data-filter="income"
      >
        Masuk
      </button>
      <button 
        class="history-tab-btn py-2 rounded-xl font-medium text-xs text-center text-text-secondary hover:text-brand-navy transition-all duration-200"
        data-filter="transfer"
      >
        Transfer
      </button>
    </div>

    <!-- 4. Ringkasan filter aktif (muncul hanya jika ada filter) -->
    <div id="active-filter-row" class="rounded-2xl border border-brand-border/70 bg-white px-3 py-2" style="display: none;">
      <div class="flex items-center gap-2">
        <p id="active-filter-text" class="min-w-0 flex-1 text-[11px] font-semibold text-text-secondary truncate"></p>
        <button id="reset-active-filters" type="button" class="shrink-0 text-[11px] font-bold text-accent-yellow-hover transition hover:text-brand-navy">
          Reset
        </button>
      </div>
    </div>

    <!-- 5. Grouped Transaction List Container -->
    <div id="tx-grouped-container" class="space-y-4">
      <p class="text-text-secondary text-sm text-center py-8">Memuat data...</p>
    </div>

  </div>

  <!-- Extended Floating Action Button (FAB) Kanan Bawah -->
  <a 
    href="/transactions" 
    class="fixed bottom-20 right-6 z-40 flex items-center gap-2.5 px-5 py-3.5 bg-accent-yellow text-brand-navy rounded-full shadow-xl shadow-accent-yellow/30 hover:bg-accent-yellow-hover hover:scale-105 active:scale-95 transition-all font-bold text-sm border-2 border-white/20 group"
    aria-label="Catat Transaksi Baru"
  >
    <div class="w-6 h-6 rounded-full bg-brand-navy text-accent-yellow flex items-center justify-center group-hover:rotate-90 transition-transform duration-300">
      <Plus class="w-4 h-4 stroke-[3]" />
    </div>
    <span class="tracking-wide">Catat Transaksi</span>
  </a>

  <!-- Modal Pilih Bulan -->
  <dialog id="month-modal" class="app-dialog" aria-labelledby="month-modal-title">
    <div class="rounded-2xl border border-brand-border bg-white shadow-xl">
      <div class="flex items-center justify-between border-b border-brand-border/60 px-5 py-4">
        <h2 id="month-modal-title" class="text-base font-bold text-brand-navy">Pilih Bulan</h2>
        <button type="button" id="close-month-modal" class="text-text-secondary transition hover:text-brand-navy" aria-label="Tutup pilihan bulan">
          <X class="w-5 h-5" />
        </button>
      </div>

      <div class="p-5">
        <div class="mb-4 flex items-center justify-between">
          <button type="button" id="picker-prev-year" class="rounded-xl p-1.5 text-brand-navy transition hover:bg-brand-light active:scale-95" aria-label="Tahun Sebelumnya">
            <ChevronLeft class="w-4 h-4 stroke-[2.5]" />
          </button>
          <span id="picker-year-label" class="text-sm font-bold text-brand-navy">2026</span>
          <button type="button" id="picker-next-year" class="rounded-xl p-1.5 text-brand-navy transition hover:bg-brand-light active:scale-95" aria-label="Tahun Selanjutnya">
            <ChevronRight class="w-4 h-4 stroke-[2.5]" />
          </button>
        </div>

        <div id="month-grid" class="grid grid-cols-3 gap-2"></div>

        <button type="button" id="picker-current-month" class="mt-4 w-full rounded-xl bg-brand-light py-2.5 text-xs font-semibold text-text-primary transition hover:bg-slate-200">
          Ke bulan ini
        </button>
      </div>
    </div>
  </dialog>

  <!-- Modal Filter -->
  <dialog id="filter-modal" class="app-dialog" aria-labelledby="filter-modal-title">
    <div class="max-h-[90vh] overflow-y-auto rounded-2xl border border-brand-border bg-white shadow-xl">
      <div class="sticky top-0 z-10 flex items-center justify-between border-b border-brand-border/60 bg-white px-5 py-4">
        <h2 id="filter-modal-title" class="text-base font-bold text-brand-navy">Filter Transaksi</h2>
        <button type="button" id="close-filter-modal" class="text-text-secondary transition hover:text-brand-navy" aria-label="Tutup filter">
          <X class="w-5 h-5" />
        </button>
      </div>

      <form id="filter-form" class="space-y-4 p-5" novalidate>
        <div data-field>
          <label for="filter-account" class="mb-1 block text-xs font-semibold text-brand-navy">Akun</label>
          <select id="filter-account" data-autofocus class="w-full rounded-xl border border-brand-border bg-brand-light/50 px-3 py-2.5 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-accent-yellow">
            <option value="">Semua akun</option>
          </select>
        </div>

        <div data-field>
          <label for="filter-category" class="mb-1 block text-xs font-semibold text-brand-navy">Kategori</label>
          <select id="filter-category" class="w-full rounded-xl border border-brand-border bg-brand-light/50 px-3 py-2.5 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-accent-yellow">
            <option value="">Semua kategori</option>
          </select>
        </div>

        <div>
          <span class="mb-1 block text-xs font-semibold text-brand-navy">Rentang tanggal</span>
          <div class="grid grid-cols-2 gap-3">
            <div data-field>
              <label for="filter-start-date" class="mb-1 block text-[11px] font-medium text-text-secondary">Dari tanggal</label>
              <input type="date" id="filter-start-date" class="w-full rounded-xl border border-brand-border bg-brand-light/50 px-3 py-2.5 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-accent-yellow" />
            </div>
            <div data-field>
              <label for="filter-end-date" class="mb-1 block text-[11px] font-medium text-text-secondary">Sampai tanggal</label>
              <input type="date" id="filter-end-date" class="w-full rounded-xl border border-brand-border bg-brand-light/50 px-3 py-2.5 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-accent-yellow" />
            </div>
          </div>
        </div>

        <div>
          <span class="mb-1 block text-xs font-semibold text-brand-navy">Rentang nominal</span>
          <div class="grid grid-cols-2 gap-3">
            <div data-field>
              <label for="filter-min" class="mb-1 block text-[11px] font-medium text-text-secondary">Minimum (Rp)</label>
              <input type="number" id="filter-min" min="0" step="1" placeholder="0" class="w-full rounded-xl border border-brand-border bg-brand-light/50 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-accent-yellow" />
            </div>
            <div data-field>
              <label for="filter-max" class="mb-1 block text-[11px] font-medium text-text-secondary">Maksimum (Rp)</label>
              <input type="number" id="filter-max" min="0" step="1" placeholder="Tanpa batas" class="w-full rounded-xl border border-brand-border bg-brand-light/50 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-accent-yellow" />
            </div>
          </div>
        </div>

        <p class="text-[11px] leading-relaxed text-text-secondary">
          Filter digabung dengan bulan/rentang tanggal dan tab tipe yang aktif.
        </p>

        <div class="flex gap-2 pt-2">
          <button type="button" id="filter-reset" class="flex-1 rounded-xl bg-brand-light py-2.5 text-xs font-semibold text-text-primary transition hover:bg-slate-200">
            Reset
          </button>
          <button type="submit" class="flex-1 rounded-xl bg-accent-yellow py-2.5 text-xs font-bold text-brand-navy transition hover:bg-accent-yellow-hover">
            Terapkan
          </button>
        </div>
      </form>
    </div>
  </dialog>

  <!-- Modal Export -->
  <dialog id="export-modal" class="app-dialog" aria-labelledby="export-modal-title">
    <div class="rounded-2xl border border-brand-border bg-white shadow-xl">
      <div class="flex items-center justify-between border-b border-brand-border/60 px-5 py-4">
        <h2 id="export-modal-title" class="text-base font-bold text-brand-navy">Export Data</h2>
        <button type="button" id="close-export-modal" class="text-text-secondary transition hover:text-brand-navy" aria-label="Tutup export">
          <X class="w-5 h-5" />
        </button>
      </div>

      <form id="export-form" class="space-y-4 p-5">
        <fieldset>
          <legend class="mb-2 block text-xs font-semibold text-brand-navy">Cakupan data</legend>
          <div class="space-y-2">
            <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-brand-border bg-brand-light/40 px-3 py-2.5 text-xs font-medium text-brand-navy">
              <input type="radio" name="export-scope" value="month" checked data-autofocus class="accent-amber-500" />
              <span id="export-month-scope-label">Bulan yang sedang dibuka</span>
            </label>
            <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-brand-border bg-brand-light/40 px-3 py-2.5 text-xs font-medium text-brand-navy">
              <input type="radio" name="export-scope" value="all" class="accent-amber-500" />
              Semua transaksi
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend class="mb-2 block text-xs font-semibold text-brand-navy">Format file</legend>
          <div class="space-y-2">
            <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-brand-border bg-brand-light/40 px-3 py-2.5 text-xs font-medium text-brand-navy">
              <input type="radio" name="export-format" value="csv" checked class="accent-amber-500" />
              CSV (Excel / Google Sheets)
            </label>
            <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-brand-border bg-brand-light/40 px-3 py-2.5 text-xs font-medium text-brand-navy">
              <input type="radio" name="export-format" value="json" class="accent-amber-500" />
              JSON (backup data)
            </label>
          </div>
        </fieldset>

        <p id="export-info" class="rounded-xl bg-brand-light px-3 py-2 text-[11px] leading-relaxed text-text-secondary">
          Menghitung data...
        </p>

        <div class="flex gap-2 pt-2">
          <button type="button" id="export-cancel" class="flex-1 rounded-xl bg-brand-light py-2.5 text-xs font-semibold text-text-primary transition hover:bg-slate-200">
            Batal
          </button>
          <button type="submit" class="flex-1 rounded-xl bg-accent-yellow py-2.5 text-xs font-bold text-brand-navy transition hover:bg-accent-yellow-hover">
            Unduh
          </button>
        </div>
      </form>
    </div>
  </dialog>

  <!-- Hidden Icon Templates -->
  <div id="icon-templates" class="hidden">
    <template data-icon-name="Utensils"><Utensils class="w-5 h-5" /></template>
    <template data-icon-name="ShoppingBag"><ShoppingBag class="w-5 h-5" /></template>
    <template data-icon-name="Car"><Car class="w-5 h-5" /></template>
    <template data-icon-name="Zap"><Zap class="w-5 h-5" /></template>
    <template data-icon-name="Banknote"><Banknote class="w-5 h-5" /></template>
    <template data-icon-name="HeartPulse"><HeartPulse class="w-5 h-5" /></template>
    <template data-icon-name="Film"><Film class="w-5 h-5" /></template>
    <template data-icon-name="ShieldAlert"><ShieldAlert class="w-5 h-5" /></template>
    <template data-icon-name="Wallet"><Wallet class="w-5 h-5" /></template>
    <template data-icon-name="CreditCard"><CreditCard class="w-5 h-5" /></template>
    <template data-icon-name="Landmark"><Landmark class="w-5 h-5" /></template>
    <template data-icon-name="PiggyBank"><PiggyBank class="w-5 h-5" /></template>
    <template data-icon-name="Coins"><Coins class="w-5 h-5" /></template>
    <template data-icon-name="ArrowLeftRight"><ArrowLeftRight class="w-5 h-5" /></template>
    <template data-icon-name="Search"><Search class="w-5 h-5" /></template>
    <template data-icon-name="Receipt"><Receipt class="w-5 h-5" /></template>
  </div>

  <script>
    import { getAllAccounts } from '../lib/db/accounts';
    import { getAllCategories } from '../lib/db/categories';
    import { getAllTransactions } from '../lib/db/transactions';
    import type { Account, Category, Transaction, TransactionType } from '../types/finance';
    import { closeDialog, initDialog, openDialog } from '../lib/ui/dialog';
    import { toast } from '../lib/ui/toast';
    import {
      clearAllErrors,
      clearOnInput,
      setFieldError,
    } from '../lib/ui/validation';
    import { emptyStateHtml } from '../lib/ui/empty-state';
    import { escapeHtml } from '../lib/ui/html';

    interface HistoryFilters {
      search: string;
      accountId: string;
      categoryId: string;
      startDate: string;
      endDate: string;
      min: number | null;
      max: number | null;
    }

    let currentDate = new Date();
    let selectedFilter: 'all' | TransactionType = 'all';
    let filters: HistoryFilters = {
      search: '',
      accountId: '',
      categoryId: '',
      startDate: '',
      endDate: '',
      min: null,
      max: null,
    };

    let latestAccounts: Account[] = [];
    let latestCategories: Category[] = [];

    let searchOpen = false;
    let searchTimer: number | null = null;
    let pickerYear = currentDate.getFullYear();

    const monthDisplay = document.getElementById('current-month-display')!;
    const monthPickerBtn = document.getElementById('month-picker-btn')!;
    const prevMonthBtn = document.getElementById('prev-month-btn')!;
    const nextMonthBtn = document.getElementById('next-month-btn')!;
    const groupedContainer = document.getElementById('tx-grouped-container')!;

    const monthPickerWrap = document.getElementById('month-picker-wrap')!;
    const rangePickerWrap = document.getElementById('range-picker-wrap')!;
    const rangePickerBtn = document.getElementById('range-picker-btn')!;
    const rangePickerLabel = document.getElementById('range-picker-label')!;
    const clearRangeBtn = document.getElementById('clear-range-btn')!;
    const searchWrap = document.getElementById('search-wrap')!;

    const searchBtn = document.getElementById('btn-search-trigger') as HTMLButtonElement;
    const filterBtn = document.getElementById('btn-filter-trigger') as HTMLButtonElement;
    const exportBtn = document.getElementById('btn-export-trigger') as HTMLButtonElement;
    const filterBadge = document.getElementById('filter-badge')!;
    const activeFilterRow = document.getElementById('active-filter-row')!;
    const activeFilterText = document.getElementById('active-filter-text')!;
    const resetActiveFiltersBtn = document.getElementById('reset-active-filters')!;

    const monthModal = document.getElementById('month-modal') as HTMLDialogElement;
    const closeMonthModalBtn = document.getElementById('close-month-modal')!;
    const pickerPrevYearBtn = document.getElementById('picker-prev-year')!;
    const pickerNextYearBtn = document.getElementById('picker-next-year')!;
    const pickerYearLabel = document.getElementById('picker-year-label')!;
    const monthGrid = document.getElementById('month-grid')!;
    const pickerCurrentMonthBtn = document.getElementById('picker-current-month')!;

    const filterModal = document.getElementById('filter-modal') as HTMLDialogElement;
    const exportModal = document.getElementById('export-modal') as HTMLDialogElement;

    const searchInput = document.getElementById('history-search') as HTMLInputElement;
    const searchClearBtn = document.getElementById('search-clear-btn') as HTMLButtonElement;

    const filterForm = document.getElementById('filter-form') as HTMLFormElement;
    const filterAccount = document.getElementById('filter-account') as HTMLSelectElement;
    const filterCategory = document.getElementById('filter-category') as HTMLSelectElement;
    const filterStartDate = document.getElementById('filter-start-date') as HTMLInputElement;
    const filterEndDate = document.getElementById('filter-end-date') as HTMLInputElement;
    const filterMin = document.getElementById('filter-min') as HTMLInputElement;
    const filterMax = document.getElementById('filter-max') as HTMLInputElement;
    const filterResetBtn = document.getElementById('filter-reset')!;
    const closeFilterModalBtn = document.getElementById('close-filter-modal')!;

    const exportForm = document.getElementById('export-form') as HTMLFormElement;
    const exportInfo = document.getElementById('export-info')!;
    const exportMonthScopeLabel = document.getElementById('export-month-scope-label')!;
    const exportCancelBtn = document.getElementById('export-cancel')!;
    const closeExportModalBtn = document.getElementById('close-export-modal')!;

    const monthNames = [
      'Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun',
      'Jul', 'Agt', 'Sep', 'Okt', 'Nov', 'Des'
    ];

    function getMonthKey(date = currentDate): string {
      return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
    }

    function updateMonthDisplay() {
      monthDisplay.textContent = `${monthNames[currentDate.getMonth()]} ${currentDate.getFullYear()}`;
    }

    function hasDateRange(): boolean {
      return Boolean(filters.startDate || filters.endDate);
    }

    function formatShortDate(dateStr: string): string {
      const date = parseLocalDate(dateStr);
      if (!date) return dateStr;
      return `${date.getDate()} ${monthNames[date.getMonth()]} ${date.getFullYear()}`;
    }

    function formatRangeLabel(startDate: string, endDate: string): string {
      if (startDate && endDate) {
        const start = parseLocalDate(startDate);
        const end = parseLocalDate(endDate);
        if (!start || !end) return `${startDate} – ${endDate}`;

        if (start.getFullYear() === end.getFullYear()) {
          return `${start.getDate()} ${monthNames[start.getMonth()]} – ${end.getDate()} ${monthNames[end.getMonth()]} ${end.getFullYear()}`;
        }

        return `${formatShortDate(startDate)} – ${formatShortDate(endDate)}`;
      }

      if (startDate) return `Dari ${formatShortDate(startDate)}`;
      return `Sampai ${formatShortDate(endDate)}`;
    }

    function updatePickerVisibility(): void {
      const rangeActive = hasDateRange();

      monthPickerWrap.style.display = searchOpen || rangeActive ? 'none' : 'flex';
      rangePickerWrap.style.display = !searchOpen && rangeActive ? 'flex' : 'none';
      searchWrap.style.display = searchOpen ? 'flex' : 'none';

      rangePickerLabel.textContent = rangeActive
        ? formatRangeLabel(filters.startDate, filters.endDate)
        : '';

      searchBtn.setAttribute('aria-expanded', String(searchOpen));
      searchBtn.classList.toggle('border-accent-yellow', searchOpen);
      searchBtn.classList.toggle('text-accent-yellow-hover', searchOpen);
      searchBtn.classList.toggle('text-text-secondary', !searchOpen);
    }

    function renderMonthGrid(): void {
      pickerYearLabel.textContent = String(pickerYear);

      monthGrid.innerHTML = monthNames
        .map((name, index) => {
          const selected =
            pickerYear === currentDate.getFullYear() &&
            index === currentDate.getMonth();

          return `
            <button
              type="button"
              data-month="${index}"
              class="rounded-xl border px-2 py-2.5 text-xs font-semibold transition ${
                selected
                  ? 'border-accent-yellow bg-accent-yellow text-brand-navy shadow-xs'
                  : 'border-brand-border/70 bg-white text-text-primary hover:border-accent-yellow hover:bg-brand-light'
              }"
            >${name}</button>
          `;
        })
        .join('');
    }

    function openMonthPicker(): void {
      pickerYear = currentDate.getFullYear();
      renderMonthGrid();
      openDialog(monthModal, '#close-month-modal');
    }

    initDialog(monthModal);

    monthPickerBtn.addEventListener('click', openMonthPicker);
    closeMonthModalBtn.addEventListener('click', () => closeDialog(monthModal));

    pickerPrevYearBtn.addEventListener('click', () => {
      pickerYear -= 1;
      renderMonthGrid();
    });

    pickerNextYearBtn.addEventListener('click', () => {
      pickerYear += 1;
      renderMonthGrid();
    });

    pickerCurrentMonthBtn.addEventListener('click', () => {
      currentDate = new Date();
      currentDate.setDate(1);
      updateMonthDisplay();
      closeDialog(monthModal);
      renderHistory();
    });

    monthGrid.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-month]');
      if (!target) return;

      const monthIndex = Number(target.dataset.month);
      if (!Number.isInteger(monthIndex)) return;

      currentDate = new Date(pickerYear, monthIndex, 1);
      updateMonthDisplay();
      closeDialog(monthModal);
      renderHistory();
    });

    prevMonthBtn.addEventListener('click', () => {
      currentDate = new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1);
      updateMonthDisplay();
      renderHistory();
    });

    nextMonthBtn.addEventListener('click', () => {
      currentDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 1);
      updateMonthDisplay();
      renderHistory();
    });

    const tabBtns = document.querySelectorAll<HTMLElement>('.history-tab-btn');
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', (event) => {
        const target = event.currentTarget as HTMLElement;
        selectedFilter = target.getAttribute('data-filter') as 'all' | TransactionType;

        tabBtns.forEach((tabBtn) => {
          tabBtn.className = 'history-tab-btn py-2 rounded-xl font-medium text-xs text-center text-text-secondary hover:text-brand-navy transition-all duration-200';
        });
        target.className = 'history-tab-btn py-2 rounded-xl font-bold text-xs text-center transition-all duration-200 bg-white text-brand-navy shadow-xs';

        renderHistory();
      });
    });

    function getLucideIconHtml(iconName: string) {
      const template = document.querySelector(`#icon-templates template[data-icon-name="${iconName}"]`) as HTMLTemplateElement;
      if (template) return template.innerHTML;
      const defaultTemplate = document.querySelector(`#icon-templates template[data-icon-name="ArrowLeftRight"]`) as HTMLTemplateElement;
      return defaultTemplate ? defaultTemplate.innerHTML : '';
    }

    function parseLocalDate(dateStr: string): Date | null {
      const [year, month, day] = dateStr.split('-').map(Number);
      if (!year || !month || !day) return null;
      const date = new Date(year, month - 1, day);
      return Number.isNaN(date.getTime()) ? null : date;
    }

    function formatDateHeader(dateStr: string) {
      const date = parseLocalDate(dateStr);
      if (!date) return dateStr;

      const today = new Date();
      if (date.toDateString() === today.toDateString()) return 'Hari ini';

      const yesterday = new Date();
      yesterday.setDate(today.getDate() - 1);
      if (date.toDateString() === yesterday.toDateString()) return 'Kemarin';

      return `${date.getDate()} ${monthNames[date.getMonth()]} ${date.getFullYear()}`;
    }

    // ---------------------------------------------------------------
    // Filter indicators
    // ---------------------------------------------------------------

    function updateFilterIndicators(): void {
      const filterCount =
        (filters.accountId ? 1 : 0) +
        (filters.categoryId ? 1 : 0) +
        (hasDateRange() ? 1 : 0) +
        (filters.min !== null || filters.max !== null ? 1 : 0);

      filterBadge.textContent = String(filterCount);
      filterBadge.style.display = filterCount > 0 ? 'flex' : 'none';

      filterBtn.classList.toggle('border-brand-border/80', filterCount === 0);
      filterBtn.classList.toggle('border-accent-yellow', filterCount > 0);
      filterBtn.classList.toggle('text-accent-yellow-hover', filterCount > 0);
      filterBtn.classList.toggle('text-brand-navy', filterCount === 0);

      const parts: string[] = [];
      if (filters.search) parts.push(`"${filters.search}"`);

      if (filters.accountId) {
        const account = latestAccounts.find((acc) => acc.id === filters.accountId);
        if (account) parts.push(account.name);
      }

      if (filters.categoryId) {
        const category = latestCategories.find((cat) => cat.id === filters.categoryId);
        if (category) parts.push(category.name);
      }

      if (hasDateRange()) {
        parts.push(formatRangeLabel(filters.startDate, filters.endDate));
      }

      if (filters.min !== null || filters.max !== null) {
        const minLabel = filters.min !== null ? `Rp ${filters.min.toLocaleString('id-ID')}` : 'Rp 0';
        const maxLabel = filters.max !== null ? `Rp ${filters.max.toLocaleString('id-ID')}` : 'tanpa batas';
        parts.push(`${minLabel} – ${maxLabel}`);
      }

      activeFilterText.textContent = parts.length > 0 ? `Filter aktif: ${parts.join(' • ')}` : '';
      activeFilterRow.style.display = parts.length > 0 ? 'block' : 'none';

      updatePickerVisibility();
    }

    function resetAllFilters(): void {
      filters = {
        search: '',
        accountId: '',
        categoryId: '',
        startDate: '',
        endDate: '',
        min: null,
        max: null,
      };
      searchInput.value = '';
      searchClearBtn.style.display = 'none';
      filterAccount.value = '';
      filterCategory.value = '';
      filterStartDate.value = '';
      filterEndDate.value = '';
      filterMin.value = '';
      filterMax.value = '';
      clearAllErrors(filterForm);
      renderHistory();
    }

    resetActiveFiltersBtn.addEventListener('click', resetAllFilters);

    // ---------------------------------------------------------------
    // Search realtime (debounce 300ms, menggantikan month picker)
    // ---------------------------------------------------------------

    function applySearch(): void {
      if (searchTimer !== null) {
        window.clearTimeout(searchTimer);
        searchTimer = null;
      }

      filters.search = searchInput.value.trim();
      searchClearBtn.style.display = filters.search ? 'flex' : 'none';
      renderHistory();
    }

    function openSearch(): void {
      searchOpen = true;
      updatePickerVisibility();
      window.setTimeout(() => searchInput.focus({ preventScroll: true }), 40);
    }

    function closeSearch(): void {
      searchOpen = false;

      if (searchTimer !== null) {
        window.clearTimeout(searchTimer);
        searchTimer = null;
      }

      searchInput.value = '';
      searchClearBtn.style.display = 'none';
      filters.search = '';
      updatePickerVisibility();
      renderHistory();
    }

    searchBtn.addEventListener('click', () => {
      if (searchOpen) closeSearch();
      else openSearch();
    });

    searchInput.addEventListener('input', () => {
      searchClearBtn.style.display = searchInput.value ? 'flex' : 'none';

      if (searchTimer !== null) window.clearTimeout(searchTimer);

      searchTimer = window.setTimeout(() => {
        searchTimer = null;
        filters.search = searchInput.value.trim();
        renderHistory();
      }, 300);
    });

    searchInput.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        closeSearch();
      } else if (event.key === 'Enter') {
        event.preventDefault();
        applySearch();
      }
    });

    searchClearBtn.addEventListener('click', () => {
      searchInput.value = '';
      searchClearBtn.style.display = 'none';
      applySearch();
      searchInput.focus();
    });

    // ---------------------------------------------------------------
    // Rentang tanggal cepat (chip)
    // ---------------------------------------------------------------

    rangePickerBtn.addEventListener('click', async () => {
      await populateFilterOptions();
      openDialog(filterModal, '#filter-account');
    });

    clearRangeBtn.addEventListener('click', () => {
      filters.startDate = '';
      filters.endDate = '';
      filterStartDate.value = '';
      filterEndDate.value = '';
      renderHistory();
    });

    // ---------------------------------------------------------------
    // Filter
    // ---------------------------------------------------------------

    initDialog(filterModal, () => clearAllErrors(filterForm));

    async function populateFilterOptions(): Promise<void> {
      const [accounts, categories] = await Promise.all([
        getAllAccounts(),
        getAllCategories(),
      ]);

      latestAccounts = accounts;
      latestCategories = categories;

      filterAccount.innerHTML =
        '<option value="">Semua akun</option>' +
        accounts
          .map((acc) => `<option value="${escapeHtml(acc.id)}">${escapeHtml(acc.name)}</option>`)
          .join('');

      filterCategory.innerHTML =
        '<option value="">Semua kategori</option>' +
        categories
          .filter((cat) => cat.name.toLowerCase() !== 'koreksi saldo')
          .map((cat) => {
            const typeLabel = cat.type === 'income' ? 'Masuk' : cat.type === 'transfer' ? 'Transfer' : 'Keluar';
            return `<option value="${escapeHtml(cat.id)}">${escapeHtml(cat.name)} (${typeLabel})</option>`;
          })
          .join('');

      filterAccount.value = filters.accountId;
      filterCategory.value = filters.categoryId;
      filterStartDate.value = filters.startDate;
      filterEndDate.value = filters.endDate;
      filterMin.value = filters.min !== null ? String(filters.min) : '';
      filterMax.value = filters.max !== null ? String(filters.max) : '';
    }

    filterBtn.addEventListener('click', async () => {
      await populateFilterOptions();
      openDialog(filterModal, '#filter-account');
    });

    closeFilterModalBtn.addEventListener('click', () => closeDialog(filterModal));

    clearOnInput([filterMin, filterMax, filterStartDate, filterEndDate, filterAccount, filterCategory]);

    filterForm.addEventListener('submit', (event) => {
      event.preventDefault();
      clearAllErrors(filterForm);

      const startDate = filterStartDate.value;
      const endDate = filterEndDate.value;
      const minRaw = filterMin.value.trim();
      const maxRaw = filterMax.value.trim();
      const min = minRaw === '' ? null : Number(minRaw);
      const max = maxRaw === '' ? null : Number(maxRaw);

      let hasError = false;

      if (startDate && endDate && startDate > endDate) {
        setFieldError(filterEndDate, 'Tanggal akhir tidak boleh sebelum tanggal awal.');
        hasError = true;
      }

      if (min !== null && (!Number.isFinite(min) || min < 0)) {
        setFieldError(filterMin, 'Nominal minimum tidak valid.');
        hasError = true;
      }

      if (max !== null && (!Number.isFinite(max) || max < 0)) {
        setFieldError(filterMax, 'Nominal maksimum tidak valid.');
        hasError = true;
      }

      if (!hasError && min !== null && max !== null && min > max) {
        setFieldError(filterMax, 'Maksimum tidak boleh lebih kecil dari minimum.');
        hasError = true;
      }

      if (hasError) {
        toast.error('Periksa kembali filter yang ditandai.');
        return;
      }

      filters.accountId = filterAccount.value;
      filters.categoryId = filterCategory.value;
      filters.startDate = startDate;
      filters.endDate = endDate;
      filters.min = min;
      filters.max = max;

      closeDialog(filterModal);
      renderHistory();
    });

    filterResetBtn.addEventListener('click', () => {
      filters.accountId = '';
      filters.categoryId = '';
      filters.startDate = '';
      filters.endDate = '';
      filters.min = null;
      filters.max = null;
      filterAccount.value = '';
      filterCategory.value = '';
      filterStartDate.value = '';
      filterEndDate.value = '';
      filterMin.value = '';
      filterMax.value = '';
      clearAllErrors(filterForm);
      closeDialog(filterModal);
      renderHistory();
    });

    // ---------------------------------------------------------------
    // Export
    // ---------------------------------------------------------------

    initDialog(exportModal);

    async function updateExportInfo(): Promise<void> {
      const transactions = await getAllTransactions();
      const monthKey = getMonthKey();
      const rangeActive = hasDateRange();

      const visibleCount = rangeActive
        ? transactions.filter(
            (tx) =>
              (!filters.startDate || tx.date >= filters.startDate) &&
              (!filters.endDate || tx.date <= filters.endDate)
          ).length
        : transactions.filter((tx) => tx.date.startsWith(monthKey)).length;

      const label = rangeActive ? 'Rentang aktif' : monthDisplay.textContent;
      exportInfo.textContent = `${label}: ${visibleCount} transaksi • Semua: ${transactions.length} transaksi.`;
    }

    exportBtn.addEventListener('click', async () => {
      exportMonthScopeLabel.textContent = hasDateRange()
        ? 'Rentang tanggal aktif'
        : 'Bulan yang sedang dibuka';
      exportInfo.textContent = 'Menghitung data...';
      openDialog(exportModal, 'input[name="export-scope"]');
      await updateExportInfo();
    });

    closeExportModalBtn.addEventListener('click', () => closeDialog(exportModal));
    exportCancelBtn.addEventListener('click', () => closeDialog(exportModal));

    function typeLabel(type: TransactionType): string {
      if (type === 'income') return 'Masuk';
      if (type === 'expense') return 'Keluar';
      return 'Transfer';
    }

    function downloadFile(filename: string, content: string, mime: string): void {
      const blob = new Blob([content], { type: mime });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = filename;
      document.body.appendChild(link);
      link.click();
      link.remove();
      window.setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    function csvCell(value: unknown): string {
      return `"${String(value ?? '').replace(/"/g, '""')}"`;
    }

    let exportBusy = false;
    const exportSubmitBtn = exportForm.querySelector<HTMLButtonElement>('button[type="submit"]');

    exportForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (exportBusy) return;

      exportBusy = true;
      if (exportSubmitBtn) {
        exportSubmitBtn.disabled = true;
        exportSubmitBtn.textContent = 'Menyiapkan...';
      }

      try {
        const scopeInput = document.querySelector<HTMLInputElement>('input[name="export-scope"]:checked');
        const formatInput = document.querySelector<HTMLInputElement>('input[name="export-format"]:checked');
        const scope = scopeInput?.value === 'all' ? 'all' : 'month';
        const format = formatInput?.value === 'json' ? 'json' : 'csv';

        const [transactions, accounts, categories] = await Promise.all([
          getAllTransactions(),
          getAllAccounts(),
          getAllCategories(),
        ]);

        const monthKey = getMonthKey();
        const rangeActive = hasDateRange();
        const scoped = scope === 'all'
          ? transactions
          : rangeActive
            ? transactions.filter(
                (tx) =>
                  (!filters.startDate || tx.date >= filters.startDate) &&
                  (!filters.endDate || tx.date <= filters.endDate)
              )
            : transactions.filter((tx) => tx.date.startsWith(monthKey));

        if (scoped.length === 0) {
          toast.error('Tidak ada transaksi untuk diekspor.');
          return;
        }

        const accountMap = new Map(accounts.map((acc) => [acc.id, acc.name]));
        const categoryMap = new Map(categories.map((cat) => [cat.id, cat.name]));

        const rows = [...scoped]
          .sort((a, b) => b.date.localeCompare(a.date) || b.createdAt - a.createdAt)
          .map((tx) => ({
            id: tx.id,
            date: tx.date,
            type: tx.type,
            typeLabel: typeLabel(tx.type),
            amount: tx.amount,
            categoryId: tx.categoryId,
            categoryName: categoryMap.get(tx.categoryId) ?? '',
            accountId: tx.accountId,
            accountName: accountMap.get(tx.accountId) ?? '',
            toAccountId: tx.toAccountId ?? '',
            toAccountName: tx.toAccountId ? accountMap.get(tx.toAccountId) ?? '' : '',
            note: tx.note ?? '',
            createdAt: tx.createdAt,
          }));

        const filenameBase = scope === 'all'
          ? 'semua-transaksi'
          : rangeActive
            ? `riwayat-${filters.startDate || 'awal'}_${filters.endDate || 'akhir'}`
            : `riwayat-${monthKey}`;
        const exportScope = scope === 'all' ? 'all' : rangeActive ? 'range' : 'month';

        if (format === 'json') {
          const payload = {
            app: 'personal-finance',
            version: 1,
            exportedAt: new Date().toISOString(),
            scope: exportScope,
            count: rows.length,
            transactions: rows,
          };
          downloadFile(
            `${filenameBase}.json`,
            JSON.stringify(payload, null, 2),
            'application/json;charset=utf-8'
          );
        } else {
          const header = [
            'Tanggal',
            'Tipe',
            'Jumlah',
            'Kategori',
            'Akun',
            'Akun Tujuan',
            'Catatan',
          ];
          const lines = [
            header.map(csvCell).join(','),
            ...rows.map((row) =>
              [
                row.date,
                row.typeLabel,
                row.amount,
                row.categoryName,
                row.accountName,
                row.toAccountName,
                row.note,
              ]
                .map(csvCell)
                .join(',')
            ),
          ];
          downloadFile(
            `${filenameBase}.csv`,
            `\uFEFF${lines.join('\r\n')}`,
            'text/csv;charset=utf-8'
          );
        }

        closeDialog(exportModal);
        toast.success(`${rows.length} transaksi berhasil diekspor.`);
      } catch {
        toast.error('Gagal mengekspor data. Coba lagi.');
      } finally {
        exportBusy = false;
        if (exportSubmitBtn) {
          exportSubmitBtn.disabled = false;
          exportSubmitBtn.textContent = 'Unduh';
        }
      }
    });

    // ---------------------------------------------------------------
    // List rendering
    // ---------------------------------------------------------------

    groupedContainer.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest('[data-empty-action="reset-filters"]');
      if (trigger) resetAllFilters();
    });

    async function renderHistory() {
      const [transactions, accounts, categories] = await Promise.all([
        getAllTransactions(),
        getAllAccounts(),
        getAllCategories(),
      ]);

      latestAccounts = accounts;
      latestCategories = categories;

      const accountMap = new Map<string, Account>(accounts.map((acc) => [acc.id, acc]));
      const categoryMap = new Map<string, Category>(categories.map((cat) => [cat.id, cat]));

      const monthKey = getMonthKey();
      const rangeActive = hasDateRange();

      let filteredTx = rangeActive
        ? transactions.filter(
            (tx) =>
              (!filters.startDate || tx.date >= filters.startDate) &&
              (!filters.endDate || tx.date <= filters.endDate)
          )
        : transactions.filter((tx) => tx.date.startsWith(monthKey));

      if (selectedFilter !== 'all') {
        filteredTx = filteredTx.filter((tx) => tx.type === selectedFilter);
      }

      const searchTerm = filters.search.trim().toLowerCase();

      filteredTx = filteredTx.filter((tx) => {
        const cat = categoryMap.get(tx.categoryId);
        const acc = accountMap.get(tx.accountId);
        const toAcc = tx.toAccountId ? accountMap.get(tx.toAccountId) : null;

        if (filters.accountId && tx.accountId !== filters.accountId && tx.toAccountId !== filters.accountId) {
          return false;
        }

        if (filters.categoryId && tx.categoryId !== filters.categoryId) {
          return false;
        }

        if (filters.min !== null && tx.amount < filters.min) return false;
        if (filters.max !== null && tx.amount > filters.max) return false;

        if (searchTerm) {
          const haystack = [
            tx.note ?? '',
            cat?.name ?? '',
            acc?.name ?? '',
            toAcc?.name ?? '',
          ]
            .join(' ')
            .toLowerCase();
          if (!haystack.includes(searchTerm)) return false;
        }

        return true;
      });

      updateFilterIndicators();

      if (filteredTx.length === 0) {
        const hasFilters =
          Boolean(filters.search) ||
          Boolean(filters.accountId) ||
          Boolean(filters.categoryId) ||
          hasDateRange() ||
          filters.min !== null ||
          filters.max !== null;

        const typeName =
          selectedFilter === 'income'
            ? 'pemasukan'
            : selectedFilter === 'expense'
              ? 'pengeluaran'
              : selectedFilter === 'transfer'
                ? 'transfer'
                : '';

        groupedContainer.innerHTML = emptyStateHtml({
          iconHtml: getLucideIconHtml(hasFilters ? 'Search' : 'Receipt'),
          title: hasFilters
            ? 'Tidak ada transaksi yang cocok'
            : typeName
              ? `Belum ada transaksi ${typeName} bulan ini`
              : 'Belum ada transaksi bulan ini',
          description: hasFilters
            ? 'Coba ubah kata kunci, rentang tanggal, nominal, atau reset filter.'
            : 'Mulai catat pemasukan dan pengeluaran pertamamu di bulan ini.',
          actionHtml: hasFilters
            ? `
              <button
                type="button"
                data-empty-action="reset-filters"
                class="inline-flex items-center gap-1.5 rounded-xl bg-accent-yellow px-4 py-2 text-[11px] font-bold text-brand-navy shadow-xs transition hover:bg-accent-yellow-hover active:scale-95"
              >
                Reset filter
              </button>
            `
            : `
              <a
                href="/transactions"
                class="inline-flex items-center gap-1.5 rounded-xl bg-accent-yellow px-4 py-2 text-[11px] font-bold text-brand-navy shadow-xs transition hover:bg-accent-yellow-hover active:scale-95"
              >
                Catat transaksi
              </a>
            `,
        });
        return;
      }

      const groupedMap = new Map<string, Transaction[]>();
      filteredTx.sort((a, b) => b.date.localeCompare(a.date) || b.createdAt - a.createdAt);

      filteredTx.forEach((tx) => {
        if (!groupedMap.has(tx.date)) {
          groupedMap.set(tx.date, []);
        }
        groupedMap.get(tx.date)!.push(tx);
      });

      let htmlContent = '';

      groupedMap.forEach((txList, dateKey) => {
        const dateFormatted = formatDateHeader(dateKey);

        const txItemsHtml = txList.map((tx) => {
          const cat = categoryMap.get(tx.categoryId);
          const acc = accountMap.get(tx.accountId);
          const toAcc = tx.toAccountId ? accountMap.get(tx.toAccountId) : null;

          const iconName = cat?.icon || (tx.type === 'transfer' ? 'ArrowLeftRight' : 'Wallet');
          const colorClass = cat?.color || 'text-brand-navy bg-amber-50';
          const [textColor, bgColor] = colorClass.split(' ');

          let accountAndCategory = '';
          const categoryName = cat?.name || (tx.type === 'transfer' ? 'Transfer' : 'Kategori Dihapus');
          
          if (tx.type === 'transfer') {
            const accName = acc?.name || 'Asal';
            const toAccName = toAcc?.name || 'Tujuan';
            accountAndCategory = `${categoryName} • ${accName} → ${toAccName}`;
          } else {
            const accName = acc?.name || 'Akun Dihapus';
            accountAndCategory = `${categoryName} • ${accName}`;
          }

          const headlineText = tx.note && tx.note.trim() !== '' ? tx.note : categoryName;

          let amountColorClass = 'text-brand-navy';
          let amountPrefix = '';
          if (tx.type === 'income') {
            amountColorClass = 'text-finance-green';
            amountPrefix = '+ ';
          } else if (tx.type === 'expense') {
            amountColorClass = 'text-finance-red';
            amountPrefix = '- ';
          }

          return `
            <a 
              href="/transactions?id=${encodeURIComponent(tx.id)}"
              class="flex justify-between items-center p-3.5 border border-brand-border/60 rounded-2xl bg-white hover:border-accent-yellow hover:shadow-xs transition block"
            >
              <div class="flex items-center gap-3 min-w-0">
                <div class="w-11 h-11 rounded-xl flex items-center justify-center shrink-0 ${bgColor || 'bg-amber-50'} ${textColor || 'text-brand-navy'} shadow-xs border border-brand-border/40">
                  ${getLucideIconHtml(iconName)}
                </div>
                <div class="min-w-0">
                  <p class="font-bold text-brand-navy text-sm truncate">${escapeHtml(headlineText)}</p>
                  <p class="text-[11px] text-text-secondary mt-0.5 truncate">${escapeHtml(accountAndCategory)}</p>
                </div>
              </div>
              <div class="text-right shrink-0 pl-2">
                <p class="text-sm font-extrabold ${amountColorClass}">
                  ${amountPrefix}Rp ${tx.amount.toLocaleString('id-ID')}
                </p>
              </div>
            </a>
          `;
        }).join('');

        htmlContent += `
          <div class="space-y-2">
            <div class="flex justify-between items-center px-1 pt-1">
              <span class="text-xs font-bold text-brand-navy uppercase tracking-wider">${escapeHtml(dateFormatted)}</span>
            </div>
            <div class="space-y-2">
              ${txItemsHtml}
            </div>
          </div>
        `;
      });

      groupedContainer.innerHTML = htmlContent;
    }

    updateMonthDisplay();
    renderHistory();
  </script>
</Layout>
