---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { 
  Utensils, ShoppingBag, Car, Zap, Banknote, HeartPulse, Film, ShieldAlert, 
  ArrowLeftRight, Wallet, CreditCard, Landmark, PiggyBank, Coins, 
  Plus, ChevronLeft, ChevronRight, Search, SlidersHorizontal, Download, ArrowUpRight, ArrowDownLeft, Calendar
} from '@lucide/astro';
---

<Layout title="Riwayat Transaksi" activeTab='history'>
  <div class="space-y-4 relative pb-20">
    
    <!-- 1. Header Bersih -->
    <Header 
      title="Riwayat Transaksi" 
      subtitle="Semua catatan pemasukan, pengeluaran, dan transfer lu ada di sini."
    />

    <!-- 2. Action Bar (Single Row: Month Picker (kiri) + 3 Icon Buttons (kanan)) -->
    <div class="flex items-center gap-2 px-1">
      <!-- Month Picker (Flexible / Lebih Panjang di Kiri) -->
      <div class="flex-1 flex items-center justify-between py-2 px-3 rounded-2xl bg-white border border-brand-border/80 shadow-xs">
        <button id="prev-month-btn" class="p-1.5 rounded-xl text-brand-navy hover:bg-brand-light active:scale-95 transition-all" aria-label="Bulan Sebelumnya">
          <ChevronLeft class="w-4 h-4 stroke-[2.5]" />
        </button>
        
        <div class="flex items-center gap-1.5">
          <Calendar class="w-4 h-4 text-accent-yellow shrink-0" />
          <span id="current-month-display" class="font-bold text-xs sm:text-sm text-brand-navy tracking-tight">Mei 2026</span>
        </div>

        <button id="next-month-btn" class="p-1.5 rounded-xl text-brand-navy hover:bg-brand-light active:scale-95 transition-all" aria-label="Bulan Selanjutnya">
          <ChevronRight class="w-4 h-4 stroke-[2.5]" />
        </button>
      </div>

      <!-- 3 Icon Buttons di Kanan -->
      <div class="flex items-center gap-1.5 shrink-0">
        <button id="btn-search-trigger" class="p-3 rounded-2xl bg-white border border-brand-border/80 text-text-secondary hover:text-brand-navy hover:border-accent-yellow transition shadow-xs" title="Cari Transaksi">
          <Search class="w-4 h-4" />
        </button>
        <button id="btn-filter-trigger" class="p-3 rounded-2xl bg-white border border-brand-border/80 text-brand-navy hover:bg-brand-light transition shadow-xs" title="Filter Transaksi">
          <SlidersHorizontal class="w-4 h-4" />
        </button>
        <button id="btn-export-trigger" class="p-3 rounded-2xl bg-white border border-brand-border/80 text-brand-navy hover:bg-brand-light transition shadow-xs" title="Export Data">
          <Download class="w-4 h-4" />
        </button>
      </div>
    </div>

    <!-- 3. Tabs Quick Filter (Semua, Keluar, Masuk, Transfer) -->
    <div class="p-1.5 rounded-2xl bg-slate-200/70 backdrop-blur-md grid grid-cols-4 gap-1 border border-brand-border/40">
      <button 
        class="history-tab-btn py-2 rounded-xl font-bold text-xs text-center transition-all duration-200 bg-white text-brand-navy shadow-xs"
        data-filter="all"
      >
        Semua
      </button>
      <button 
        class="history-tab-btn py-2 rounded-xl font-medium text-xs text-center text-text-secondary hover:text-brand-navy transition-all duration-200"
        data-filter="expense"
      >
        Keluar
      </button>
      <button 
        class="history-tab-btn py-2 rounded-xl font-medium text-xs text-center text-text-secondary hover:text-brand-navy transition-all duration-200"
        data-filter="income"
      >
        Masuk
      </button>
      <button 
        class="history-tab-btn py-2 rounded-xl font-medium text-xs text-center text-text-secondary hover:text-brand-navy transition-all duration-200"
        data-filter="transfer"
      >
        Transfer
      </button>
    </div>

    <!-- 4. Grouped Transaction List Container -->
    <div id="tx-grouped-container" class="space-y-4">
      <p class="text-text-secondary text-sm text-center py-8">Memuat data...</p>
    </div>

  </div>

  <!-- Extended Floating Action Button (FAB) Kanan Bawah -->
  <a 
    href="/transactions" 
    class="fixed bottom-20 right-6 z-40 flex items-center gap-2.5 px-5 py-3.5 bg-accent-yellow text-brand-navy rounded-full shadow-xl shadow-accent-yellow/30 hover:bg-accent-yellow-hover hover:scale-105 active:scale-95 transition-all font-bold text-sm border-2 border-white/20 group"
    aria-label="Catat Transaksi Baru"
  >
    <div class="w-6 h-6 rounded-full bg-brand-navy text-accent-yellow flex items-center justify-center group-hover:rotate-90 transition-transform duration-300">
      <Plus class="w-4 h-4 stroke-[3]" />
    </div>
    <span class="tracking-wide">Catat Transaksi</span>
  </a>

  <!-- Hidden Icon Templates -->
  <div id="icon-templates" class="hidden">
    <template data-icon-name="Utensils"><Utensils class="w-5 h-5" /></template>
    <template data-icon-name="ShoppingBag"><ShoppingBag class="w-5 h-5" /></template>
    <template data-icon-name="Car"><Car class="w-5 h-5" /></template>
    <template data-icon-name="Zap"><Zap class="w-5 h-5" /></template>
    <template data-icon-name="Banknote"><Banknote class="w-5 h-5" /></template>
    <template data-icon-name="HeartPulse"><HeartPulse class="w-5 h-5" /></template>
    <template data-icon-name="Film"><Film class="w-5 h-5" /></template>
    <template data-icon-name="ShieldAlert"><ShieldAlert class="w-5 h-5" /></template>
    <template data-icon-name="Wallet"><Wallet class="w-5 h-5" /></template>
    <template data-icon-name="CreditCard"><CreditCard class="w-5 h-5" /></template>
    <template data-icon-name="Landmark"><Landmark class="w-5 h-5" /></template>
    <template data-icon-name="PiggyBank"><PiggyBank class="w-5 h-5" /></template>
    <template data-icon-name="Coins"><Coins class="w-5 h-5" /></template>
    <template data-icon-name="ArrowLeftRight"><ArrowLeftRight class="w-5 h-5" /></template>
  </div>

  <script>
    import { getAllAccounts } from '../lib/db/accounts';
    import { getAllCategories } from '../lib/db/categories';
    import { getAllTransactions } from '../lib/db/transactions';
    import type { Account, Category, Transaction, TransactionType } from '../types/finance';

    let currentDate = new Date();
    let selectedFilter: 'all' | TransactionType = 'all';

    const monthDisplay = document.getElementById('current-month-display')!;
    const prevMonthBtn = document.getElementById('prev-month-btn')!;
    const nextMonthBtn = document.getElementById('next-month-btn')!;
    const groupedContainer = document.getElementById('tx-grouped-container')!;

    const monthNames = [
      'Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun',
      'Jul', 'Agt', 'Sep', 'Okt', 'Nov', 'Des'
    ];

    function updateMonthDisplay() {
      const month = monthNames[currentDate.getMonth()];
      const year = currentDate.getFullYear();
      monthDisplay.textContent = `${month} ${year}`;
    }

    prevMonthBtn.addEventListener('click', () => {
      currentDate.setMonth(currentDate.getMonth() - 1);
      updateMonthDisplay();
      renderHistory();
    });

    nextMonthBtn.addEventListener('click', () => {
      currentDate.setMonth(currentDate.getMonth() + 1);
      updateMonthDisplay();
      renderHistory();
    });

    const tabBtns = document.querySelectorAll('.history-tab-btn');
    tabBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        selectedFilter = target.getAttribute('data-filter') as 'all' | TransactionType;

        tabBtns.forEach(b => {
          b.className = "history-tab-btn py-2 rounded-xl font-medium text-xs text-center text-text-secondary hover:text-brand-navy transition-all duration-200";
        });
        target.className = "history-tab-btn py-2 rounded-xl font-bold text-xs text-center transition-all duration-200 bg-white text-brand-navy shadow-xs";

        renderHistory();
      });
    });

    function getLucideIconHtml(iconName: string) {
      const template = document.querySelector(`#icon-templates template[data-icon-name="${iconName}"]`) as HTMLTemplateElement;
      if (template) return template.innerHTML;
      const defaultTemplate = document.querySelector(`#icon-templates template[data-icon-name="ArrowLeftRight"]`) as HTMLTemplateElement;
      return defaultTemplate ? defaultTemplate.innerHTML : '';
    }

    function formatDateHeader(dateStr: string) {
      const d = new Date(dateStr);
      if (isNaN(d.getTime())) return dateStr;
      
      const today = new Date();
      if (d.toDateString() === today.toDateString()) return 'Hari ini';
      
      const yesterday = new Date();
      yesterday.setDate(today.getDate() - 1);
      if (d.toDateString() === yesterday.toDateString()) return 'Kemarin';

      return `${d.getDate()} ${monthNames[d.getMonth()]} ${d.getFullYear()}`;
    }

    async function renderHistory() {
      const transactions = await getAllTransactions();
      const accounts = await getAllAccounts();
      const categories = await getAllCategories();

      const accountMap = new Map<string, Account>(accounts.map(a => [a.id, a]));
      const categoryMap = new Map<string, Category>(categories.map(c => [c.id, c]));

      const targetMonth = currentDate.getMonth();
      const targetYear = currentDate.getFullYear();

      let filteredTx = transactions.filter(tx => {
        const txDate = new Date(tx.date);
        return txDate.getMonth() === targetMonth && txDate.getFullYear() === targetYear;
      });

      if (selectedFilter !== 'all') {
        filteredTx = filteredTx.filter(tx => tx.type === selectedFilter);
      }

      if (filteredTx.length === 0) {
        groupedContainer.innerHTML = `
          <div class="text-center py-10 bg-white/50 border border-brand-border/60 rounded-2xl">
            <p class="text-text-secondary text-sm font-medium">Tidak ada transaksi pada bulan ini.</p>
          </div>
        `;
        return;
      }

      const groupedMap = new Map<string, Transaction[]>();
      filteredTx.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

      filteredTx.forEach(tx => {
        const dateKey = tx.date;
        if (!groupedMap.has(dateKey)) {
          groupedMap.set(dateKey, []);
        }
        groupedMap.get(dateKey)!.push(tx);
      });

      let htmlContent = '';

      groupedMap.forEach((txList, dateKey) => {
        const dateFormatted = formatDateHeader(dateKey);

        const txItemsHtml = txList.map(tx => {
          const cat = categoryMap.get(tx.categoryId);
          const acc = accountMap.get(tx.accountId);
          const toAcc = tx.toAccountId ? accountMap.get(tx.toAccountId) : null;

          const iconName = cat?.icon || (tx.type === 'transfer' ? 'ArrowLeftRight' : 'Wallet');
          const colorClass = cat?.color || 'text-brand-navy bg-amber-50';
          const [textColor, bgColor] = colorClass.split(' ');

          // Susunan Akun & Kategori (Sub-teks)
          let accountAndCategory = '';
          const categoryName = cat?.name || (tx.type === 'transfer' ? 'Transfer' : 'Kategori Dihapus');
          
          if (tx.type === 'transfer') {
            const accName = acc?.name || 'Asal';
            const toAccName = toAcc?.name || 'Tujuan';
            accountAndCategory = `${categoryName} • ${accName} → ${toAccName}`;
          } else {
            const accName = acc?.name || 'Akun Dihapus';
            accountAndCategory = `${categoryName} • ${accName}`;
          }

          // Deskripsi / Catatan jadi Headline Utama (Fallback ke nama kategori jika catatan kosong)
          const headlineText = tx.note && tx.note.trim() !== '' ? tx.note : categoryName;

          let amountColorClass = 'text-brand-navy';
          let amountPrefix = '';
          if (tx.type === 'income') {
            amountColorClass = 'text-finance-green';
            amountPrefix = '+ ';
          } else if (tx.type === 'expense') {
            amountColorClass = 'text-finance-red';
            amountPrefix = '- ';
          }

          return `
            <a 
              href="/transactions?id=${tx.id}"
              class="flex justify-between items-center p-3.5 border border-brand-border/60 rounded-2xl bg-white hover:border-accent-yellow hover:shadow-xs transition block"
            >
              <div class="flex items-center gap-3 min-w-0">
                <div class="w-11 h-11 rounded-xl flex items-center justify-center shrink-0 ${bgColor || 'bg-amber-50'} ${textColor || 'text-brand-navy'} shadow-xs border border-brand-border/40">
                  ${getLucideIconHtml(iconName)}
                </div>
                <div class="min-w-0">
                  <!-- Headline: Catatan/Deskripsi Transaksi -->
                  <p class="font-bold text-brand-navy text-sm truncate">${headlineText}</p>
                  <!-- Sub-teks: Kategori & Akun -->
                  <p class="text-[11px] text-text-secondary mt-0.5 truncate">${accountAndCategory}</p>
                </div>
              </div>
              <div class="text-right shrink-0 pl-2">
                <p class="text-sm font-extrabold ${amountColorClass}">
                  ${amountPrefix}Rp ${tx.amount.toLocaleString('id-ID')}
                </p>
              </div>
            </a>
          `;
        }).join('');

        htmlContent += `
          <div class="space-y-2">
            <div class="flex justify-between items-center px-1 pt-1">
              <span class="text-xs font-bold text-brand-navy uppercase tracking-wider">${dateFormatted}</span>
            </div>
            <div class="space-y-2">
              ${txItemsHtml}
            </div>
          </div>
        `;
      });

      groupedContainer.innerHTML = htmlContent;
    }

    updateMonthDisplay();
    renderHistory();
  </script>
</Layout>