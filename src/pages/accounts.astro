---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { Wallet, CreditCard, Landmark, PiggyBank, Coins, Plus, X, ArrowUpRight, Activity, ArrowUpDown, Check, ChevronUp, ChevronDown } from '@lucide/astro';
---

<Layout title="Accounts" activeTab='accounts'>
  <div class="space-y-6">
    
    <!-- 1. Header yang baru -->
    <Header 
      title="Daftar Akun" 
      centerTitle
    />

    <!-- 2. Main Card & Micro Info Grid -->
    <section class="relative overflow-hidden rounded-[28px] bg-brand-navy text-white p-5 shadow-xl border border-white/10">
      <div class="absolute -right-12 -top-16 w-48 h-48 rounded-full bg-accent-yellow/15 blur-3xl pointer-events-none"></div>
      <div class="absolute right-[-40px] bottom-[-70px] w-44 h-44 rounded-full bg-white/5 pointer-events-none"></div>
      <div class="absolute left-[-60px] bottom-[-90px] w-52 h-52 rounded-full bg-white/5 pointer-events-none"></div>

      <!-- Konten Utama: Total Saldo -->
      <div class="relative z-10">
        <div class="flex items-center justify-between gap-3">
          <div class="flex min-w-0 items-center gap-2">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/10">
              <Wallet class="w-4 h-4 text-accent-yellow" />
            </span>
            <span class="truncate text-[11px] font-semibold text-slate-200">Total Saldo Seluruh Akun</span>
          </div>

          <button
            id="sort-toggle"
            type="button"
            aria-pressed="false"
            style="display: none;"
            class="shrink-0 items-center gap-1.5 rounded-full border border-white/10 bg-white/10 px-3 py-1.5 text-[11px] font-semibold text-slate-100 transition hover:bg-white/15 active:scale-95"
          >
            <span id="sort-icon-default" class="flex items-center">
              <ArrowUpDown class="w-3.5 h-3.5 text-accent-yellow" />
            </span>
            <span id="sort-icon-done" style="display: none;" class="items-center">
              <Check class="w-3.5 h-3.5" />
            </span>
            <span id="sort-toggle-label">Urutkan</span>
          </button>
        </div>

        <div class="flex items-baseline gap-2 mt-3">
          <h2 id="total-combined-balance" class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white tabular-nums">Rp 0</h2>
          <span class="text-xs font-medium text-finance-green flex items-center bg-finance-green/10 px-2 py-0.5 rounded-full">
            <ArrowUpRight class="w-3.5 h-3.5 inline mr-0.5" /> Live
          </span>
        </div>
      </div>

      <!-- Garis Pemisah (Divider) -->
      <div class="relative z-10 my-5 border-t border-white/10"></div>

      <!-- 3 Micro Info di Dalam Card Wrapper (Dipisah Kolom/Garis Tipis) -->
      <div class="relative z-10 grid grid-cols-3 gap-3 divide-x divide-white/10">
        <!-- Info 1: Jumlah Wallet -->
        <div class="flex flex-col justify-between pr-2">
          <span class="text-[11px] font-medium text-slate-300">Dompet</span>
          <div class="flex items-center gap-1.5 mt-1.5">
            <Wallet class="w-4 h-4 text-accent-yellow shrink-0" />
            <span id="micro-wallet-count" class="text-xs sm:text-sm font-bold text-white">0 Akun</span>
          </div>
        </div>

        <!-- Info 2: Top Wallet -->
        <div class="flex flex-col justify-between px-2">
          <span class="text-[11px] font-medium text-slate-300">Teratas</span>
          <div class="flex items-center gap-1.5 mt-1.5 overflow-hidden">
            <Landmark class="w-4 h-4 text-finance-green shrink-0" />
            <span id="micro-top-wallet" class="text-xs sm:text-sm font-bold text-white truncate">--</span>
          </div>
        </div>

        <!-- Info 3: Total Aktivitas -->
        <div class="flex flex-col justify-between pl-2">
          <span class="text-[11px] font-medium text-slate-300">Aktivitas</span>
          <div class="flex items-center gap-1.5 mt-1.5">
            <Activity class="w-4 h-4 text-amber-400 shrink-0" />
            <span id="micro-monthly-activity" class="text-xs sm:text-sm font-bold text-white">0 Tx</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. List Akun (Clean Vertical Stack) -->
    <div class="space-y-3">
      <h3 class="text-xs font-bold text-text-secondary uppercase tracking-wider px-1">Daftar Dompet Tersedia</h3>
      <div id="accounts-list" class="space-y-2.5">
        <p class="text-text-secondary text-sm text-center py-6">Memuat data...</p>
      </div>
    </div>
  </div>

  <!-- Floating Action Button (FAB) Extended: Icon + Teks yang Kontras -->
  <button 
    id="open-add-modal" 
    class="fixed bottom-20 right-6 z-40 flex items-center gap-2.5 px-5 py-3.5 bg-accent-yellow text-brand-navy rounded-full shadow-xl shadow-accent-yellow/30 hover:bg-accent-yellow-hover hover:scale-105 active:scale-95 transition-all font-bold text-sm border-2 border-white/20 group"
    aria-label="Tambah Akun Baru"
  >
    <div class="w-6 h-6 rounded-full bg-brand-navy text-accent-yellow flex items-center justify-center group-hover:rotate-90 transition-transform duration-300">
      <Plus class="w-4 h-4 stroke-[3]" />
    </div>
    <span class="tracking-wide">Tambah Akun</span>
  </button>
  
  <!-- Modal Detail & Aksi Akun (Trigger by Click Item) -->
  <dialog id="account-detail-modal" class="app-dialog" aria-labelledby="detail-modal-name">
    <div class="relative rounded-2xl border border-brand-border bg-white p-6 text-center shadow-xl">
      <button
        type="button"
        id="close-detail-modal"
        class="absolute top-4 right-4 text-text-secondary hover:text-brand-navy transition"
        aria-label="Tutup detail akun"
      >
        <X class="w-5 h-5" />
      </button>

      <!-- Icon Akun Terpilih -->
      <div id="detail-modal-icon-wrapper" class="w-14 h-14 rounded-2xl mx-auto flex items-center justify-center shadow-xs border border-brand-border/50 mb-3">
        <!-- Rendered via JS -->
      </div>

      <h3 id="detail-modal-name" class="text-base font-bold text-brand-navy">Nama Akun</h3>
      <p class="text-xs text-text-secondary mt-0.5">Saldo Saat Ini</p>
      <p id="detail-modal-balance" class="text-xl font-extrabold text-brand-navy mt-1">Rp 0</p>
      <p id="detail-modal-activity" class="text-xs font-medium text-text-secondary mt-2 bg-brand-light py-1.5 px-3 rounded-xl inline-block">Aktivitas: 0 transaksi</p>

      <!-- Action Buttons (Edit & Hapus) -->
      <div class="grid grid-cols-2 gap-2.5 mt-6 pt-4 border-t border-brand-border/60">
        <button type="button" id="detail-edit-btn" class="w-full bg-brand-light text-brand-navy font-semibold py-2.5 rounded-xl hover:bg-slate-200 transition text-xs flex items-center justify-center gap-1.5">
          Edit Akun
        </button>
        <button type="button" id="detail-delete-btn" class="w-full bg-rose-50 text-finance-red font-semibold py-2.5 rounded-xl hover:bg-rose-100 transition text-xs flex items-center justify-center gap-1.5">
          Hapus Akun
        </button>
      </div>
    </div>
  </dialog>
  
  <!-- Modal Box Form (Create / Edit) -->
  <dialog id="account-modal" class="app-dialog" aria-labelledby="modal-title">
    <div class="max-h-[90vh] overflow-y-auto rounded-2xl border border-brand-border bg-white shadow-xl">
      <div class="flex justify-between items-center px-6 py-4 border-b border-brand-border/60 sticky top-0 z-10 bg-white">
        <h3 id="modal-title" class="text-base font-bold text-brand-navy">Tambah Akun Baru</h3>
        <button
          type="button"
          id="close-modal"
          class="text-text-secondary hover:text-brand-navy transition"
          aria-label="Tutup form akun"
        >
          <X class="w-5 h-5" />
        </button>
      </div>

      <form id="account-form" class="p-6 space-y-4" novalidate>
        <input type="hidden" id="edit-id" value="" />
        <input type="hidden" id="icon" value="Wallet" />
        <input type="hidden" id="color" value="text-brand-navy bg-amber-50" />
        
        <div data-field>
          <label class="block text-xs font-semibold text-brand-navy mb-1" for="name">Nama Akun (cth: BCA, Dompet Saku)</label>
          <input
            type="text"
            id="name"
            required
            maxlength="40"
            data-autofocus
            class="w-full px-3 py-2 border border-brand-border rounded-xl focus:outline-none focus:ring-2 focus:ring-accent-yellow text-sm bg-brand-light/50"
          />
        </div>

        <div data-field>
          <label class="block text-xs font-semibold text-brand-navy mb-1" for="balance">Saldo Saat Ini (Rp)</label>
          <input
            type="number"
            id="balance"
            value="0"
            required
            class="w-full px-3 py-2 border border-brand-border rounded-xl focus:outline-none focus:ring-2 focus:ring-accent-yellow text-sm bg-brand-light/50"
          />
          <p class="text-[11px] text-text-secondary mt-1">*Selisih dari saldo saat ini akan otomatis dicatat sebagai "Koreksi Saldo".</p>
        </div>

        <!-- Custom Icon Picker Grid -->
        <div>
          <label class="block text-xs font-semibold text-brand-navy mb-2">Pilih Icon</label>
          <div id="icon-picker" class="flex gap-2">
            <button type="button" data-icon-val="Wallet" class="icon-opt p-2.5 rounded-xl border-2 border-accent-yellow bg-accent-yellow/10 transition text-brand-navy">
              <Wallet class="w-5 h-5" />
            </button>
            <button type="button" data-icon-val="CreditCard" class="icon-opt p-2.5 rounded-xl border-2 border-brand-border hover:border-accent-yellow transition text-text-secondary">
              <CreditCard class="w-5 h-5" />
            </button>
            <button type="button" data-icon-val="Landmark" class="icon-opt p-2.5 rounded-xl border-2 border-brand-border hover:border-accent-yellow transition text-text-secondary">
              <Landmark class="w-5 h-5" />
            </button>
            <button type="button" data-icon-val="PiggyBank" class="icon-opt p-2.5 rounded-xl border-2 border-brand-border hover:border-accent-yellow transition text-text-secondary">
              <PiggyBank class="w-5 h-5" />
            </button>
            <button type="button" data-icon-val="Coins" class="icon-opt p-2.5 rounded-xl border-2 border-brand-border hover:border-accent-yellow transition text-text-secondary">
              <Coins class="w-5 h-5" />
            </button>
          </div>
        </div>

        <!-- Custom Color Picker Grid -->
        <div>
          <label class="block text-xs font-semibold text-brand-navy mb-2">Pilih Warna Tema</label>
          <div id="color-picker" class="flex gap-3 items-center">
            <button type="button" data-color-val="text-amber-500 bg-amber-50" class="color-opt w-7 h-7 rounded-full bg-amber-500 ring-2 ring-offset-2 ring-amber-500 transition" aria-label="Warna amber"></button>
            <button type="button" data-color-val="text-emerald-700 bg-emerald-50" class="color-opt w-7 h-7 rounded-full bg-finance-green transition" aria-label="Warna hijau"></button>
            <button type="button" data-color-val="text-violet-700 bg-violet-50" class="color-opt w-7 h-7 rounded-full bg-violet-500 transition" aria-label="Warna violet"></button>
            <button type="button" data-color-val="text-blue-700 bg-blue-50" class="color-opt w-7 h-7 rounded-full bg-blue-500 transition" aria-label="Warna biru"></button>
            <button type="button" data-color-val="text-rose-700 bg-rose-50" class="color-opt w-7 h-7 rounded-full bg-finance-red transition" aria-label="Warna merah"></button>
          </div>
        </div>

        <div class="flex gap-2 pt-4 border-t border-brand-border/60">
          <button type="button" id="cancel-modal" class="flex-1 bg-brand-light text-text-primary font-semibold py-2.5 rounded-xl hover:bg-slate-200 transition text-xs">Batal</button>
          <button type="submit" id="submit-btn" class="flex-1 bg-accent-yellow text-brand-navy font-bold py-2.5 rounded-xl hover:bg-accent-yellow-hover transition text-xs shadow-xs">Simpan Akun</button>
        </div>
      </form>
    </div>
  </dialog>

  <!-- Hidden Icon Templates -->
  <div id="icon-templates" class="hidden">
    <template data-icon-name="Wallet"><Wallet class="w-5 h-5" /></template>
    <template data-icon-name="CreditCard"><CreditCard class="w-5 h-5" /></template>
    <template data-icon-name="Landmark"><Landmark class="w-5 h-5" /></template>
    <template data-icon-name="PiggyBank"><PiggyBank class="w-5 h-5" /></template>
    <template data-icon-name="Coins"><Coins class="w-5 h-5" /></template>
    <template data-icon-name="ChevronUp"><ChevronUp class="w-3.5 h-3.5" /></template>
    <template data-icon-name="ChevronDown"><ChevronDown class="w-3.5 h-3.5" /></template>
  </div>

  <script>
    import { getAllAccounts, addAccount, deleteAccount, getAccountCurrentBalance, updateAccount } from '../lib/db/accounts';
    import { getAllTransactions } from '../lib/db/transactions';
    import { closeDialog, initDialog, openDialog } from '../lib/ui/dialog';
    import { toast } from '../lib/ui/toast';
    import { confirmAction } from '../lib/ui/confirm';
    import {
      clearAllErrors,
      clearOnInput,
      showFieldErrors,
      type FieldError,
    } from '../lib/ui/validation';
    import { emptyStateHtml } from '../lib/ui/empty-state';
    import { escapeHtml } from '../lib/ui/html';
    import {
      readAccountOrder,
      writeAccountOrder,
      sortByStoredOrder,
    } from '../lib/ui/account-order';

    const modal = document.getElementById('account-modal') as HTMLDialogElement;
    const detailModal = document.getElementById('account-detail-modal') as HTMLDialogElement;
    const openModalBtn = document.getElementById('open-add-modal')!;
    const closeModalBtn = document.getElementById('close-modal')!;
    const cancelModalBtn = document.getElementById('cancel-modal')!;
    const closeDetailModalBtn = document.getElementById('close-detail-modal')!;

    const form = document.getElementById('account-form') as HTMLFormElement;
    const modalTitle = document.getElementById('modal-title')!;
    const editIdInput = document.getElementById('edit-id') as HTMLInputElement;
    const nameInput = document.getElementById('name') as HTMLInputElement;
    const balanceInput = document.getElementById('balance') as HTMLInputElement;
    const iconInput = document.getElementById('icon') as HTMLInputElement;
    const colorInput = document.getElementById('color') as HTMLInputElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const listContainer = document.getElementById('accounts-list')!;

    const sortToggleBtn = document.getElementById('sort-toggle') as HTMLButtonElement;
    const sortToggleLabel = document.getElementById('sort-toggle-label')!;
    const sortIconDefault = document.getElementById('sort-icon-default')!;
    const sortIconDone = document.getElementById('sort-icon-done')!;

    const detailIconWrapper = document.getElementById('detail-modal-icon-wrapper')!;
    const detailName = document.getElementById('detail-modal-name')!;
    const detailBalance = document.getElementById('detail-modal-balance')!;
    const detailActivity = document.getElementById('detail-modal-activity')!;
    const detailEditBtn = document.getElementById('detail-edit-btn') as HTMLButtonElement;
    const detailDeleteBtn = document.getElementById('detail-delete-btn') as HTMLButtonElement;

    const iconBtns = document.querySelectorAll<HTMLElement>('.icon-opt');
    const colorBtns = document.querySelectorAll<HTMLElement>('.color-opt');

    let accountOrder = readAccountOrder();
    let sortMode = false;
    let workingOrder: string[] = [];
    let orderAtStart: string[] = [];
    let renderedAccountIds: string[] = [];

    // ---------------------------------------------------------------
    // Urutan akun (sort mode)
    // ---------------------------------------------------------------

    function updateSortUi(): void {
      const active = sortMode;

      sortToggleLabel.textContent = active ? 'Selesai' : 'Urutkan';
      sortToggleBtn.setAttribute('aria-pressed', String(active));
      sortIconDefault.style.display = active ? 'none' : 'flex';
      sortIconDone.style.display = active ? 'flex' : 'none';

      sortToggleBtn.classList.toggle('bg-accent-yellow', active);
      sortToggleBtn.classList.toggle('text-brand-navy', active);
      sortToggleBtn.classList.toggle('border-accent-yellow', active);
      sortToggleBtn.classList.toggle('bg-white/10', !active);
      sortToggleBtn.classList.toggle('text-slate-100', !active);
      sortToggleBtn.classList.toggle('border-white/10', !active);
    }

    function enterSortMode(): void {
      if (sortMode) return;

      sortMode = true;
      workingOrder = [...renderedAccountIds];
      orderAtStart = [...renderedAccountIds];
      updateSortUi();
      renderAccounts();
    }

    function exitSortMode(): void {
      if (!sortMode) return;

      const changed =
        workingOrder.length !== orderAtStart.length ||
        workingOrder.some((id, index) => id !== orderAtStart[index]);

      const finalOrder = [...workingOrder];

      sortMode = false;
      workingOrder = [];
      orderAtStart = [];

      if (changed) {
        accountOrder = finalOrder;
        writeAccountOrder(accountOrder);
        toast.success('Urutan akun disimpan.');
      }

      updateSortUi();
      renderAccounts();
    }

    function moveAccount(id: string, direction: -1 | 1): void {
      if (!sortMode) return;

      const index = workingOrder.indexOf(id);
      const target = index + direction;
      if (index === -1 || target < 0 || target >= workingOrder.length) return;

      [workingOrder[index], workingOrder[target]] = [
        workingOrder[target],
        workingOrder[index],
      ];

      renderAccounts();
    }

    sortToggleBtn.addEventListener('click', () => {
      if (sortMode) exitSortMode();
      else enterSortMode();
    });

    // ---------------------------------------------------------------
    // Modal lifecycle
    // ---------------------------------------------------------------

    function resetForm() {
      form.reset();
      editIdInput.value = '';
      clearAllErrors(form);
      setSelectedIconInPicker('Wallet');
      setSelectedColorInPicker('text-brand-navy bg-amber-50');
    }

    function openModal(isEdit = false) {
      modalTitle.textContent = isEdit ? 'Edit Akun' : 'Tambah Akun Baru';
      submitBtn.textContent = isEdit ? 'Perbarui Akun' : 'Simpan Akun';
      openDialog(modal, '#name');
    }

    initDialog(detailModal);
    initDialog(modal, resetForm);

    openModalBtn.addEventListener('click', () => openModal(false));
    closeModalBtn.addEventListener('click', () => closeDialog(modal));
    cancelModalBtn.addEventListener('click', () => closeDialog(modal));
    closeDetailModalBtn.addEventListener('click', () => closeDialog(detailModal));

    // ---------------------------------------------------------------
    // Icon & color pickers
    // ---------------------------------------------------------------

    iconBtns.forEach((btn) => {
      btn.addEventListener('click', (event) => {
        const selectedVal = (event.currentTarget as HTMLElement).getAttribute('data-icon-val') || 'Wallet';
        iconInput.value = selectedVal;

        iconBtns.forEach((b) => {
          b.classList.remove('border-accent-yellow', 'bg-accent-yellow/10');
          b.classList.add('border-brand-border');
        });

        (event.currentTarget as HTMLElement).classList.remove('border-brand-border');
        (event.currentTarget as HTMLElement).classList.add('border-accent-yellow', 'bg-accent-yellow/10');
      });
    });

    colorBtns.forEach((btn) => {
      btn.addEventListener('click', (event) => {
        const selectedVal = (event.currentTarget as HTMLElement).getAttribute('data-color-val') || 'text-brand-navy bg-amber-50';
        colorInput.value = selectedVal;

        colorBtns.forEach((b) => b.classList.remove('ring-2', 'ring-offset-2', 'ring-amber-500'));
        (event.currentTarget as HTMLElement).classList.add('ring-2', 'ring-offset-2', 'ring-amber-500');
      });
    });

    function setSelectedIconInPicker(val: string) {
      iconInput.value = val;
      iconBtns.forEach((btn) => {
        if (btn.getAttribute('data-icon-val') === val) {
          btn.classList.remove('border-brand-border');
          btn.classList.add('border-accent-yellow', 'bg-accent-yellow/10');
        } else {
          btn.classList.remove('border-accent-yellow', 'bg-accent-yellow/10');
          btn.classList.add('border-brand-border');
        }
      });
    }

    function setSelectedColorInPicker(val: string) {
      colorInput.value = val;
      colorBtns.forEach((btn) => {
        if (btn.getAttribute('data-color-val') === val) {
          btn.classList.add('ring-2', 'ring-offset-2', 'ring-amber-500');
        } else {
          btn.classList.remove('ring-2', 'ring-offset-2', 'ring-amber-500');
        }
      });
    }

    function getLucideIconHtml(iconName: string) {
      const template = document.querySelector(`#icon-templates template[data-icon-name="${iconName}"]`) as HTMLTemplateElement;
      if (template) return template.innerHTML;
      const defaultTemplate = document.querySelector(`#icon-templates template[data-icon-name="Wallet"]`) as HTMLTemplateElement;
      return defaultTemplate ? defaultTemplate.innerHTML : '';
    }

    // ---------------------------------------------------------------
    // List rendering
    // ---------------------------------------------------------------

    listContainer.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest('[data-empty-action="add-account"]');
      if (trigger) openModal(false);
    });

    async function renderAccounts() {
      const [accounts, transactions] = await Promise.all([
        getAllAccounts(),
        getAllTransactions(),
      ]);

      const now = new Date();
      const monthKey = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
      const monthlyTransactions = transactions.filter((tx) => tx.date.startsWith(monthKey));

      const monthlyActivityEl = document.getElementById('micro-monthly-activity');
      if (monthlyActivityEl) monthlyActivityEl.textContent = `${monthlyTransactions.length} Tx`;
      
      const walletCountEl = document.getElementById('micro-wallet-count');
      if (walletCountEl) walletCountEl.textContent = `${accounts.length} Akun`;

      sortToggleBtn.style.display = accounts.length > 1 ? 'inline-flex' : 'none';

      if (accounts.length < 2 && sortMode) {
        sortMode = false;
        workingOrder = [];
        orderAtStart = [];
      }
      updateSortUi();

      if (accounts.length === 0) {
        renderedAccountIds = [];
        listContainer.innerHTML = emptyStateHtml({
          iconHtml: getLucideIconHtml('Wallet'),
          title: 'Belum ada dompet',
          description: 'Tambahkan akun pertama (BCA, Cash, e-wallet) untuk mulai mencatat saldo dan transaksi.',
          actionHtml: `
            <button
              type="button"
              data-empty-action="add-account"
              class="inline-flex items-center gap-1.5 rounded-xl bg-accent-yellow px-4 py-2 text-[11px] font-bold text-brand-navy shadow-xs transition hover:bg-accent-yellow-hover active:scale-95"
            >
              Tambah Dompet
            </button>
          `,
        });

        const totalBalEl = document.getElementById('total-combined-balance');
        if (totalBalEl) totalBalEl.textContent = 'Rp 0';
        const topWalletEl = document.getElementById('micro-top-wallet');
        if (topWalletEl) topWalletEl.textContent = '-';
        return;
      }

      let totalBalanceAll = 0;
      let highestBalance = -Infinity;
      let topWalletName = '-';

      const orderedAccounts = sortByStoredOrder(
        accounts,
        sortMode ? workingOrder : accountOrder
      );
      renderedAccountIds = orderedAccounts.map((acc) => acc.id);

      if (sortMode) workingOrder = [...renderedAccountIds];

      const accountCards = await Promise.all(
        orderedAccounts.map(async (acc, index) => {
          const currentBalance = await getAccountCurrentBalance(acc.id);
          totalBalanceAll += currentBalance;

          if (currentBalance > highestBalance) {
            highestBalance = currentBalance;
            topWalletName = acc.name;
          }

          const iconName = acc.icon || 'Wallet';
          const colorClass = acc.color || 'text-brand-navy bg-amber-50';
          const [textColor, bgColor] = colorClass.split(' ');

          // Total aktivitas akun ini pada bulan berjalan
          const activityCount = monthlyTransactions.filter(
            (tx) => tx.accountId === acc.id || tx.toAccountId === acc.id
          ).length;

          const sortControls = sortMode
            ? `
              <div class="flex flex-col gap-1">
                <button
                  type="button"
                  class="sort-move-btn flex h-6 w-6 items-center justify-center rounded-lg border border-brand-border/70 bg-brand-light text-brand-navy transition hover:border-accent-yellow disabled:pointer-events-none disabled:opacity-30"
                  data-id="${escapeHtml(acc.id)}"
                  data-move="up"
                  aria-label="Naikkan ${escapeHtml(acc.name)}"
                  ${index === 0 ? 'disabled' : ''}
                >
                  ${getLucideIconHtml('ChevronUp')}
                </button>
                <button
                  type="button"
                  class="sort-move-btn flex h-6 w-6 items-center justify-center rounded-lg border border-brand-border/70 bg-brand-light text-brand-navy transition hover:border-accent-yellow disabled:pointer-events-none disabled:opacity-30"
                  data-id="${escapeHtml(acc.id)}"
                  data-move="down"
                  aria-label="Turunkan ${escapeHtml(acc.name)}"
                  ${index === orderedAccounts.length - 1 ? 'disabled' : ''}
                >
                  ${getLucideIconHtml('ChevronDown')}
                </button>
              </div>
            `
            : '';

          return `
            <div 
              class="account-card flex justify-between items-center p-4 border ${sortMode ? 'border-accent-yellow/60 cursor-default' : 'border-brand-border/80 cursor-pointer hover:border-accent-yellow hover:shadow-md'} rounded-2xl bg-white shadow-xs transition"
              data-id="${escapeHtml(acc.id)}"
              data-name="${escapeHtml(acc.name)}"
              data-balance="${currentBalance}" 
              data-icon="${escapeHtml(iconName)}"
              data-color="${escapeHtml(colorClass)}"
              data-activity="${activityCount}"
            >
              <div class="flex items-center gap-3 min-w-0">
                <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0 ${bgColor || 'bg-amber-50'} ${textColor || 'text-brand-navy'} shadow-xs border border-brand-border/50">
                  ${getLucideIconHtml(iconName)}
                </div>
                <div class="min-w-0">
                  <p class="font-bold text-brand-navy text-sm truncate">${escapeHtml(acc.name)}</p>
                  <p class="text-xs text-text-secondary mt-0.5">${activityCount} aktivitas bulan ini</p>
                </div>
              </div>
              <div class="flex shrink-0 items-center gap-2">
                <div class="text-right">
                  <p class="text-sm font-extrabold text-brand-navy">Rp ${currentBalance.toLocaleString('id-ID')}</p>
                </div>
                ${sortControls}
              </div>
            </div>
          `;
        })
      );

      const totalBalEl = document.getElementById('total-combined-balance');
      if (totalBalEl) totalBalEl.textContent = `Rp ${totalBalanceAll.toLocaleString('id-ID')}`;

      const topWalletEl = document.getElementById('micro-top-wallet');
      if (topWalletEl) topWalletEl.textContent = topWalletName;

      listContainer.innerHTML = accountCards.join('');

      document.querySelectorAll<HTMLElement>('.account-card').forEach((card) => {
        if (sortMode) return;

        card.addEventListener('click', (event) => {
          const el = event.currentTarget as HTMLElement;
          const id = el.getAttribute('data-id') || '';
          const name = el.getAttribute('data-name') || '';
          const balance = parseFloat(el.getAttribute('data-balance') || '0');
          const iconName = el.getAttribute('data-icon') || 'Wallet';
          const colorClass = el.getAttribute('data-color') || 'text-brand-navy bg-amber-50';
          const activity = el.getAttribute('data-activity') || '0';

          const [textColor, bgColor] = colorClass.split(' ');

          detailIconWrapper.className = `w-14 h-14 rounded-2xl mx-auto flex items-center justify-center shadow-xs border border-brand-border/50 mb-3 ${bgColor} ${textColor}`;
          detailIconWrapper.innerHTML = getLucideIconHtml(iconName);
          detailName.textContent = name;
          detailBalance.textContent = `Rp ${balance.toLocaleString('id-ID')}`;
          detailActivity.textContent = `Aktivitas: ${activity} transaksi`;

          detailEditBtn.onclick = () => {
            closeDialog(detailModal);
            editIdInput.value = id;
            nameInput.value = name;
            balanceInput.value = balance.toString();
            setSelectedIconInPicker(iconName);
            setSelectedColorInPicker(colorClass);
            clearAllErrors(form);
            openModal(true);
          };

          detailDeleteBtn.onclick = async () => {
            if (detailDeleteBtn.dataset.busy === '1') return;

            const confirmed = await confirmAction({
              title: 'Hapus akun?',
              message: `"${name}" akan dihapus permanen. Tindakan ini tidak bisa dibatalkan.`,
              confirmLabel: 'Hapus Akun',
              variant: 'danger',
            });
            if (!confirmed) return;

            detailDeleteBtn.dataset.busy = '1';
            detailDeleteBtn.disabled = true;

            try {
              const res = await deleteAccount(id);

              if (!res.success) {
                toast.error(res.message);
                return;
              }

              closeDialog(detailModal);
              toast.success(res.message || 'Akun berhasil dihapus.');
              await renderAccounts();
            } catch {
              toast.error('Gagal menghapus akun. Coba lagi.');
            } finally {
              detailDeleteBtn.dataset.busy = '0';
              detailDeleteBtn.disabled = false;
            }
          };

          openDialog(detailModal, '#close-detail-modal');
        });
      });

      listContainer.querySelectorAll<HTMLButtonElement>('.sort-move-btn').forEach((btn) => {
        btn.addEventListener('click', (event) => {
          event.stopPropagation();
          moveAccount(
            btn.getAttribute('data-id') || '',
            btn.getAttribute('data-move') === 'up' ? -1 : 1
          );
        });
      });
    }

    // ---------------------------------------------------------------
    // Validation + submit
    // ---------------------------------------------------------------

    clearOnInput([nameInput, balanceInput]);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitBtn.dataset.busy === '1') return;

      const editId = editIdInput.value;
      const name = nameInput.value.trim();
      const balanceRaw = balanceInput.value.trim();
      const targetBalance = Number(balanceRaw);
      const icon = iconInput.value;
      const color = colorInput.value;

      const errors: FieldError[] = [];

      if (!name) {
        errors.push({ field: nameInput, message: 'Nama akun wajib diisi.' });
      } else if (name.length > 40) {
        errors.push({ field: nameInput, message: 'Nama akun maksimal 40 karakter.' });
      } else {
        const existingAccounts = await getAllAccounts();
        const duplicate = existingAccounts.some(
          (acc) => acc.id !== editId && acc.name.trim().toLowerCase() === name.toLowerCase()
        );
        if (duplicate) {
          errors.push({ field: nameInput, message: 'Nama akun ini sudah dipakai.' });
        }
      }

      if (!balanceRaw || !Number.isFinite(targetBalance)) {
        errors.push({ field: balanceInput, message: 'Saldo harus berupa angka yang valid.' });
      }

      clearAllErrors(form);
      if (showFieldErrors(errors)) {
        toast.error('Periksa kembali field yang ditandai.');
        return;
      }

      submitBtn.dataset.busy = '1';
      submitBtn.disabled = true;
      submitBtn.textContent = 'Menyimpan...';

      try {
        if (editId) {
          const res = await updateAccount(editId, { name, targetBalance, icon, color });
          if (!res.success) {
            toast.error(res.message);
            return;
          }
          toast.success(res.message);
        } else {
          const newId = await addAccount({ name, balance: targetBalance, icon, color });
          if (!newId) {
            toast.error('Gagal menyimpan akun.');
            return;
          }
          toast.success('Akun berhasil ditambahkan.');
        }

        closeDialog(modal);
        await renderAccounts();
      } catch {
        toast.error('Terjadi kesalahan saat menyimpan akun. Coba lagi.');
      } finally {
        submitBtn.dataset.busy = '0';
        submitBtn.disabled = false;
        submitBtn.textContent = editId ? 'Perbarui Akun' : 'Simpan Akun';
      }
    });

    renderAccounts();
  </script>
</Layout>
