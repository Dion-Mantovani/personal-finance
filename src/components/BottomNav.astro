---
import {
  ArrowDownLeft,
  ArrowLeftRight,
  ArrowUpRight,
  Home,
  Wallet,
  History,
  Settings,
  Plus,
  X,
} from '@lucide/astro';

interface Props {
  activeTab?: 'dashboard' | 'accounts' | 'categories' | 'history' | 'settings';
}

const { activeTab = 'dashboard' } = Astro.props;

const pathname = Astro.url.pathname;

const navItems = [
  { id: 'dashboard', label: 'Home', href: '/', icon: Home },
  { id: 'accounts', label: 'Dompet', href: '/accounts', icon: Wallet },
  { id: 'history', label: 'Riwayat', href: '/history', icon: History },
  { id: 'settings', label: 'Pengaturan', href: '/settings', icon: Settings },
];

const leftItems = navItems.slice(0, 2);
const rightItems = navItems.slice(2);
---

<!-- Floating bottom navigation -->
<div
  class="pointer-events-none fixed inset-x-0 bottom-0 z-50 mx-auto w-full max-w-md bg-linear-to-t from-background via-background/95 to-transparent px-4 pt-6 pb-3"
  style="padding-bottom: calc(0.75rem + env(safe-area-inset-bottom));"
>
  <nav
    class="pointer-events-auto grid grid-cols-5 items-end rounded-3xl border border-border/80 bg-card/90 px-2 py-1.5 shadow-xl shadow-primary/5 backdrop-blur-xl"
    aria-label="Navigasi utama"
  >
    {leftItems.map((item) => {
      const Icon = item.icon;
      const isActive =
        (item.id === 'dashboard' && (activeTab === 'dashboard' || pathname === '/')) ||
        item.id === activeTab;

      return (
        <a
          href={item.href}
          class={`flex flex-col items-center justify-center gap-0.5 rounded-2xl py-1.5 transition-colors ${
            isActive
              ? 'font-bold text-primary'
              : 'font-medium text-muted-foreground hover:text-foreground'
          }`}
        >
          <Icon class={`h-5 w-5 ${isActive ? 'stroke-[2.2]' : 'stroke-2'}`} />
          <span class="text-[10px]">{item.label}</span>
        </a>
      );
    })}

    <div class="relative -top-5 flex justify-center">
      <button
        type="button"
        id="open-add-menu"
        class="flex h-12 w-12 items-center justify-center rounded-full border-4 border-background bg-primary text-primary-foreground shadow-lg shadow-primary/25 transition-all hover:opacity-90 active:scale-95"
        aria-label="Tambah Transaksi"
        aria-haspopup="dialog"
        aria-controls="add-menu-dialog"
      >
        <Plus class="h-6 w-6 stroke-[2.5]" />
      </button>
    </div>

    {rightItems.map((item) => {
      const Icon = item.icon;
      const isActive = item.id === activeTab;

      return (
        <a
          href={item.href}
          class={`flex flex-col items-center justify-center gap-0.5 rounded-2xl py-1.5 transition-colors ${
            isActive
              ? 'font-bold text-primary'
              : 'font-medium text-muted-foreground hover:text-foreground'
          }`}
        >
          <Icon class={`h-5 w-5 ${isActive ? 'stroke-[2.2]' : 'stroke-2'}`} />
          <span class="text-[10px]">{item.label}</span>
        </a>
      );
    })}
  </nav>
</div>

<!-- Submenu tambah transaksi -->
<dialog id="add-menu-dialog" class="app-sheet" aria-labelledby="add-menu-title">
  <div class="sheet-panel">
    <div class="flex items-center justify-between border-b border-border px-5 py-4">
      <h2 id="add-menu-title" class="text-base font-extrabold text-primary">Tambah Transaksi</h2>
      <button
        type="button"
        id="close-add-menu"
        class="flex h-8 w-8 items-center justify-center rounded-full text-muted-foreground transition hover:bg-muted"
        aria-label="Tutup menu tambah transaksi"
      >
        <X class="h-4 w-4 stroke-[2.5]" />
      </button>
    </div>

    <div class="space-y-2 p-5">
      <a
        href="/transactions?type=expense"
        class="flex items-center gap-3.5 rounded-2xl border border-border bg-card p-3.5 transition-colors hover:bg-rose-50 active:scale-[0.99]"
      >
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-rose-500/10 text-rose-600">
          <ArrowDownLeft class="h-5 w-5 stroke-2" />
        </span>
        <span class="min-w-0 flex-1">
          <span class="block text-xs font-bold text-foreground">Pengeluaran</span>
          <span class="block text-[10px] font-medium text-muted-foreground">Catat uang keluar</span>
        </span>
      </a>

      <a
        href="/transactions?type=income"
        class="flex items-center gap-3.5 rounded-2xl border border-border bg-card p-3.5 transition-colors hover:bg-emerald-50 active:scale-[0.99]"
      >
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-emerald-500/10 text-emerald-600">
          <ArrowUpRight class="h-5 w-5 stroke-2" />
        </span>
        <span class="min-w-0 flex-1">
          <span class="block text-xs font-bold text-foreground">Pemasukan</span>
          <span class="block text-[10px] font-medium text-muted-foreground">Catat uang masuk</span>
        </span>
      </a>

      <a
        href="/transactions?type=transfer"
        class="flex items-center gap-3.5 rounded-2xl border border-border bg-card p-3.5 transition-colors hover:bg-blue-soft active:scale-[0.99]"
      >
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-blue-soft text-blue-main">
          <ArrowLeftRight class="h-5 w-5 stroke-2" />
        </span>
        <span class="min-w-0 flex-1">
          <span class="block text-xs font-bold text-foreground">Transfer</span>
          <span class="block text-[10px] font-medium text-muted-foreground">Pindahkan saldo antar akun</span>
        </span>
      </a>
    </div>
  </div>
</dialog>

<script>
  import { closeDialog, initDialog, openDialog } from '../lib/ui/dialog';

  const addMenuDialog = document.getElementById('add-menu-dialog') as HTMLDialogElement | null;
  const openAddMenuBtn = document.getElementById('open-add-menu') as HTMLButtonElement | null;
  const closeAddMenuBtn = document.getElementById('close-add-menu') as HTMLButtonElement | null;

  if (addMenuDialog && openAddMenuBtn && closeAddMenuBtn) {
    initDialog(addMenuDialog);
    openAddMenuBtn.addEventListener('click', () => {
      openDialog(addMenuDialog, 'a[href*="type=expense"]');
    });
    closeAddMenuBtn.addEventListener('click', () => closeDialog(addMenuDialog));
  }
</script>

