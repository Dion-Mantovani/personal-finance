---
import { ArrowLeft } from '@lucide/astro';

interface Props {
  title: string;
  subtitle?: string;
  showBack?: boolean;
  backHref?: string;
  centerTitle?: boolean;
}

const {
  title,
  subtitle,
  showBack = false,
  backHref = '/',
  centerTitle = false,
} = Astro.props;
---

<header
  class:list={[
    'sticky top-0 z-40 w-full bg-brand-light/80 backdrop-blur-md border-b border-brand-border/60 px-4 transition-all',
    subtitle ? 'py-3.5' : 'py-3',
  ]}
>
  <div class:list={['flex items-center gap-3', centerTitle && 'justify-center']}>
    {showBack && (
      <a 
        href={backHref}
        class="flex items-center justify-center w-9 h-9 rounded-xl bg-white/80 border border-brand-border/80 text-brand-navy shadow-xs hover:bg-slate-100 active:scale-95 transition-all shrink-0"
        aria-label="Kembali"
      >
        <ArrowLeft class="w-5 h-5 stroke-[2.2]" />
      </a>
    )}

    <div class:list={['min-w-0', centerTitle && 'text-center']}>
      <h1 class="text-lg font-bold text-brand-navy tracking-tight truncate leading-snug">
        {title}
      </h1>
      {subtitle && (
        <p class="text-xs text-text-secondary line-clamp-2 mt-0.5 font-medium">
          {subtitle}
        </p>
      )}
    </div>
  </div>
</header>
