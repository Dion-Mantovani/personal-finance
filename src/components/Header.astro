---
import { ArrowLeft } from '@lucide/astro';

interface Props {
  title: string;
  subtitle?: string;
  showBack?: boolean;
  backHref?: string;
  centerTitle?: boolean;
}

const {
  title,
  subtitle,
  showBack = false,
  backHref = '/',
  centerTitle = false,
} = Astro.props;
---

<header
  class:list={[
    'fixed top-0 z-40 -mx-4 w-[calc(100%+2rem)] border-b border-border/80 bg-background/95 px-4 backdrop-blur-md',
    subtitle ? 'py-3' : 'py-2.5',
  ]}
>
  <div
    class:list={[
      'flex items-center gap-2',
      centerTitle ? 'justify-between' : '',
    ]}
  >
    {showBack ? (
      <a
        href={backHref}
        class="flex h-9.5 w-9.5 shrink-0 items-center justify-center rounded-2xl border border-border bg-card text-muted-foreground shadow-xs transition-all hover:bg-muted active:scale-95"
        aria-label="Kembali"
      >
        <ArrowLeft class="h-4.5 w-4.5 stroke-[2.5]" />
      </a>
    ) : centerTitle ? (
      <span class="h-9.5 w-9.5 shrink-0" aria-hidden="true"></span>
    ) : null}

    <div class:list={['min-w-0 flex-1', centerTitle && 'text-center']}>
      <h1 class="truncate text-base font-extrabold leading-snug tracking-tight text-primary">
        {title}
      </h1>
      {subtitle && (
        <p class="mt-0.5 line-clamp-2 text-[11px] font-medium text-muted-foreground">
          {subtitle}
        </p>
      )}
    </div>

    {centerTitle && <span class="h-9.5 w-9.5 shrink-0" aria-hidden="true"></span>}
  </div>
</header>
