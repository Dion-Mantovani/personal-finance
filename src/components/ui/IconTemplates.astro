---

<div id="icon-templates" class="hidden" aria-hidden="true">
  {Object.entries(icons).map(([name, Icon]) => (
    <template data-icon-name={name}><Icon class="w-5 h-5" /></template>
  ))}
  <template data-icon-name="ChevronUp"><ChevronUp class="w-3.5 h-3.5" /></template>
  <template data-icon-name="ChevronDown"><ChevronDown class="w-3.5 h-3.5" /></template>
</div>
